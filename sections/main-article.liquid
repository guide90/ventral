{% style %}
  #ventral-article-{{ section.id }} {
    color: #212121;
    background: #ffffff;
  }

  #ventral-article-{{ section.id }} *,
  #ventral-article-{{ section.id }} *::before,
  #ventral-article-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #ventral-article-{{ section.id }} .ventral-article__inner {
    width: min(860px, calc(100% - 48px));
    margin: 0 auto;
    padding: 72px 0 96px;
  }

  #ventral-article-{{ section.id }} .ventral-article__header {
    margin-bottom: 40px;
    text-align: center;
  }

  #ventral-article-{{ section.id }} .ventral-article__title {
    margin: 0;
    color: #06142e;
    font-size: clamp(32px, 4vw, 52px);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.15;
  }

  #ventral-article-{{ section.id }} .ventral-article__date {
    display: block;
    margin-top: 16px;
    color: #646464;
    font-size: 14px;
    line-height: 1.4;
  }

  #ventral-article-{{ section.id }} .ventral-article__image {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 0 40px;
    border-radius: 16px;
  }

  #ventral-article-{{ section.id }} .ventral-article__content {
    color: #212121;
    font-size: 18px;
    line-height: 1.65;
  }

  #ventral-article-{{ section.id }} .ventral-article__content > *:first-child {
    margin-top: 0;
  }

  #ventral-article-{{ section.id }} .ventral-article__content > *:last-child {
    margin-bottom: 0;
  }

  #ventral-article-{{ section.id }} .ventral-article__content img {
    max-width: 100%;
    height: auto;
  }

  @media (max-width: 749px) {
    #ventral-article-{{ section.id }} .ventral-article__inner {
      width: calc(100% - 24px);
      padding: 40px 0 64px;
    }

    #ventral-article-{{ section.id }} .ventral-article__header {
      margin-bottom: 24px;
      text-align: left;
    }

    #ventral-article-{{ section.id }} .ventral-article__title {
      font-size: 32px;
      line-height: 1.2;
    }

    #ventral-article-{{ section.id }} .ventral-article__image {
      margin-bottom: 24px;
      border-radius: 12px;
    }

    #ventral-article-{{ section.id }} .ventral-article__content {
      font-size: 16px;
      line-height: 1.6;
    }
  }
{% endstyle %}

<article class="ventral-article" id="ventral-article-{{ section.id }}">
  <div class="ventral-article__inner">
    <header class="ventral-article__header">
      <h1 class="ventral-article__title">{{ article.title | escape }}</h1>
      {%- if article.published_at != blank -%}
        <time class="ventral-article__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
          {{ article.published_at | date: '%B %d, %Y' }}
        </time>
      {%- endif -%}
    </header>

    {%- if article.image != blank -%}
      {{
        article.image
        | image_url: width: 1800
        | image_tag:
          class: 'ventral-article__image',
          widths: '375, 550, 750, 1100, 1500, 1800',
          sizes: '(min-width: 900px) 860px, calc(100vw - 24px)',
          preload: true,
          alt: article.title
      }}
    {%- endif -%}

    <div class="ventral-article__content rte">
      {{ article.content }}
    </div>
  </div>
</article>

<script type="application/ld+json">
  {{ article | structured_data }}
</script>

{% schema %}
{
  "name": "Article",
  "tag": "section",
  "class": "ventral-article-section"
}
{% endschema %}
