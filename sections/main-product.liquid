    <section
      id="VmpPanel-video-{{ section.id }}"
      class="vmp-panel vmp-panel--video"
      role="tabpanel"
      aria-labelledby="VmpTab-video-{{ section.id }}"
      data-vmp-panel="video"
      hidden
      {{ video_tab.shopify_attributes }}
    >
      <div class="vmp-video">
        <h2>{{ video_tab.settings.heading | default: 'Easy To Use, Even For Beginners' }}</h2>
        <div class="vmp-video__frame" data-vmp-video-shell>
          <div class="vmp-video__cover" data-vmp-video-cover>
            {%- assign video_cover_pc = video_tab.settings.cover_image_pc -%}
            {%- assign video_cover_mobile = video_tab.settings.cover_image_mobile | default: video_cover_pc -%}
            {%- if video_cover_pc != blank -%}
              <picture class="vmp-picture">
                <source media="(max-width: 749px)" srcset="{{ video_cover_mobile | image_url: width: 900 }}">
                {{
                  video_cover_pc
                  | image_url: width: 1800
                  | image_tag:
                    loading: 'lazy',
                    widths: '600, 1000, 1400, 1800',
                    sizes: '(max-width: 749px) 100vw, 1264px',
                    alt: video_tab.settings.heading
                }}
              </picture>
            {%- elsif video_tab.settings.video.preview_image != blank -%}
              {{
                video_tab.settings.video.preview_image
                | image_url: width: 1800
                | image_tag:
                  loading: 'lazy',
                  widths: '600, 1000, 1400, 1800',
                  sizes: '(max-width: 749px) 100vw, 1264px',
                  alt: video_tab.settings.heading
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            {%- if video_tab.settings.video != blank or video_tab.settings.external_video != blank -%}
              <button type="button" class="vmp-video__play" data-vmp-video-play aria-label="Play product video">
