          </div>
          {%- if video_tab.settings.video != blank or video_tab.settings.external_video != blank -%}
            <div class="vmp-video__player" data-vmp-video-player hidden>
              {%- if video_tab.settings.video != blank -%}
                {{
                  video_tab.settings.video
                  | video_tag: controls: true, autoplay: false, loop: false, muted: false, image_size: '1800x'
                }}
              {%- elsif video_tab.settings.external_video.type == 'youtube' -%}
                <iframe
                  src="https://www.youtube.com/embed/{{ video_tab.settings.external_video.id }}"
                  title="{{ video_tab.settings.heading | escape }}"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              {%- else -%}
                <iframe
                  src="https://player.vimeo.com/video/{{ video_tab.settings.external_video.id }}"
                  title="{{ video_tab.settings.heading | escape }}"
                  allow="autoplay; fullscreen; picture-in-picture"
                  allowfullscreen
                ></iframe>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </section>

    <section
      id="VmpPanel-reviews-{{ section.id }}"
      class="vmp-panel vmp-panel--reviews"
      role="tabpanel"
      aria-labelledby="VmpTab-reviews-{{ section.id }}"
      data-vmp-panel="reviews"
      hidden
      {{ reviews_tab.shopify_attributes }}
    >
      <div class="vmp-reviews">
        <h2>{{ reviews_tab.settings.heading | default: 'Customer Reviews' }}</h2>
        <div class="vmp-reviews__app">
          {%- assign review_app_count = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              {%- assign review_app_count = review_app_count | plus: 1 -%}
              <div {{ block.shopify_attributes }}>{% render block %}</div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if review_app_count == 0 -%}
          <p class="vmp-reviews__hint">Add a review app (such as Judge.me) in the theme editor to display customer reviews here.</p>
        {%- endif -%}
      </div>
    </section>
  </div>

  {%- if section.settings.show_social_gallery -%}
    <section class="vmp-social" data-vmp-social aria-labelledby="VmpSocialHeading-{{ section.id }}">
      <div class="vmp-social__inner">
        <header class="vmp-social__header">
          <h2 id="VmpSocialHeading-{{ section.id }}">
            {{ section.settings.social_heading | default: 'Social Media Gallery' }}
          </h2>
          <a
            class="vmp-social__more"
            href="{{ section.settings.social_button_url | default: routes.all_products_collection_url }}"
          >
            {{- section.settings.social_button_label | default: 'More Items' }}
            <svg width="19" height="19" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M17.0737 0.351562L18.4965 1.75714L1.42301 18.6241L0.000214174 17.2185L17.0737 0.351562Z" fill="white"/>
              <rect x="18.6885" width="2" height="16" transform="rotate(90 18.6885 0)" fill="white"/>
              <rect x="16.6885" width="2" height="16" fill="white"/>
            </svg>
          </a>
        </header>
        <div class="vmp-social__viewport" data-vmp-social-viewport>
          <div class="vmp-social__track">
            {%- assign social_rendered_index = 0 -%}
            {%- for i in (1..3) -%}
              {%- liquid
                assign image_pc_key = 'social_image_' | append: i | append: '_pc'
                assign image_mobile_key = 'social_image_' | append: i | append: '_mobile'
                assign caption_key = 'social_caption_' | append: i
                assign url_key = 'social_url_' | append: i
                assign gallery_image_pc = section.settings[image_pc_key]
                assign gallery_image_mobile = section.settings[image_mobile_key] | default: gallery_image_pc
                assign gallery_caption = section.settings[caption_key]
                assign gallery_url = section.settings[url_key] | default: '#'
              -%}
              {%- if configured_social_count == 0 or gallery_image_pc != blank -%}
                <article class="vmp-social__card" data-vmp-social-card="{{ social_rendered_index }}">
                  <a class="vmp-social__media" href="{{ gallery_url }}" aria-label="{{ gallery_caption | escape }}">
                    {%- if gallery_image_pc != blank -%}
                      <picture class="vmp-picture">
                        <source media="(max-width: 749px)" srcset="{{ gallery_image_mobile | image_url: width: 900 }}">
                        {{
                          gallery_image_pc
                          | image_url: width: 900
                          | image_tag:
                            loading: 'lazy',
                            widths: '360, 540, 720, 900',
                            sizes: '(max-width: 749px) 300px, 411px',
                            alt: gallery_caption
                        }}
                      </picture>
                    {%- else -%}
                      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                    <span class="vmp-social__play" aria-hidden="true">
                      <svg
                        width="100"
                        height="100"
                        viewBox="0 0 100 100"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                      >
                        <path d="M96.0664 30.5332C93.5427 24.5735 89.9408 19.2299 85.3555 14.6445C80.7702 10.0592 75.4147 6.4455 69.4669 3.93365C63.3057 1.32701 56.7536 0 50 0C43.2465 0 36.7062 1.31517 30.5332 3.93365C24.5735 6.45735 19.2299 10.0592 14.6446 14.6445C10.0592 19.2299 6.4455 24.5853 3.93365 30.5332C1.32702 36.6943 0 43.2464 0 50C0 56.7536 1.32702 63.2938 3.93365 69.4668C6.45735 75.4265 10.0592 80.7701 14.6446 85.3555C19.2299 89.9408 24.5853 93.5545 30.5332 96.0664C36.6943 98.673 43.2465 100 50 100C56.7536 100 63.2939 98.673 69.4669 96.0664C75.4266 93.5427 80.7702 89.9408 85.3555 85.3555C89.9408 80.7701 93.5546 75.4147 96.0664 69.4668C98.673 63.3057 100 56.7536 100 50C100 43.2464 98.6849 36.7062 96.0664 30.5332Z" fill="black" fill-opacity="0.6"/>
                        <path d="M58.6006 49.2841L41.8064 37.4846C41.0349 36.9487 40 37.494 40 38.4342V62.0331C40 62.9733 41.0349 63.5187 41.8064 62.9827L58.61 51.1833C59.2686 50.7226 59.2592 49.7448 58.6006 49.2841Z" fill="white"/>
                      </svg>
                    </span>
                  </a>
                  <p>{{ gallery_caption }}</p>
                </article>
                {%- assign social_rendered_index = social_rendered_index | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        {%- if social_render_count > 1 -%}
          <div class="vmp-social__controls" data-vmp-social-controls>
            <div class="vmp-social__progress" aria-label="Social gallery slides">
              {%- assign social_progress_index = 0 -%}
              {%- for i in (1..3) -%}
                {%- liquid
                  assign progress_image_key = 'social_image_' | append: i | append: '_pc'
                  assign progress_image = section.settings[progress_image_key]
                -%}
                {%- if configured_social_count == 0 or progress_image != blank -%}
                  <button
                    type="button"
                    class="{% if social_progress_index == 0 %}is-active{% endif %}"
                    data-vmp-social-dot="{{ social_progress_index }}"
                    aria-label="Show social gallery item {{ social_progress_index | plus: 1 }}"
                    aria-current="{% if social_progress_index == 0 %}true{% else %}false{% endif %}"
                  ></button>
                  {%- assign social_progress_index = social_progress_index | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
            <div class="vmp-social__arrows">
              <button type="button" data-vmp-social-prev aria-label="Previous gallery item">
                <svg width="52" height="52" viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M26 0.5C40.0833 0.5 51.5 11.9167 51.5 26C51.5 40.0833 40.0833 51.5 26 51.5C11.9167 51.5 0.5 40.0833 0.5 26C0.5 11.9167 11.9167 0.5 26 0.5Z" fill="white" stroke="#BFBFBF"/>
                  <rect width="3.46562" height="13.8625" transform="matrix(0.707321 -0.706892 0.707321 0.706892 18.0781 25.7695)" fill="#666666"/>
                  <rect width="3.46562" height="13.8625" transform="matrix(-0.707321 -0.706892 0.707321 -0.706892 19.916 27.6055)" fill="#666666"/>
                </svg>
              </button>
              <button type="button" data-vmp-social-next aria-label="Next gallery item">
                <svg width="52" height="52" viewBox="0 0 52 52" fill="none" xmlns="http://www.w3.org/2000/svg">
                  <path d="M26 0.5C11.9167 0.5 0.5 11.9167 0.5 26C0.5 40.0833 11.9167 51.5 26 51.5C40.0833 51.5 51.5 40.0833 51.5 26C51.5 11.9167 40.0833 0.5 26 0.5Z" fill="white" stroke="#BFBFBF"/>
                  <rect width="3.46562" height="13.8625" transform="matrix(-0.707321 -0.706892 -0.707321 0.706892 33.9219 25.7695)" fill="#666666"/>
                  <rect width="3.46562" height="13.8625" transform="matrix(0.707321 -0.706892 -0.707321 -0.706892 32.084 27.6055)" fill="#666666"/>
                </svg>
              </button>
            </div>
          </div>
        {%- endif -%}
        <a
          class="vmp-social__mobile-more"
          href="{{ section.settings.social_button_url | default: routes.all_products_collection_url }}"
        >
          {{- section.settings.social_button_label | default: 'Explore More' }}
          <svg width="19" height="19" viewBox="0 0 19 19" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M17.0737 0.351562L18.4965 1.75714L1.42301 18.6241L0.000214174 17.2185L17.0737 0.351562Z" fill="white"/>
            <rect x="18.6885" width="2" height="16" transform="rotate(90 18.6885 0)" fill="white"/>
            <rect x="16.6885" width="2" height="16" fill="white"/>
          </svg>
        </a>
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.show_sticky_bar -%}
    <div class="vmp-sticky" data-vmp-sticky>
      <div class="vmp-sticky__inner">
        <div class="vmp-sticky__product">
          <span class="vmp-sticky__thumb">
            {%- if product.featured_media != blank -%}
              {{
                product.featured_media.preview_image
                | image_url: width: 160
                | image_tag: loading: 'lazy', width: 80, height: 80, alt: product.title
              }}
            {%- elsif section.settings.fallback_product_image_pc != blank -%}
              {{
                section.settings.fallback_product_image_pc
                | image_url: width: 160
                | image_tag: loading: 'lazy', width: 80, height: 80, alt: product.title
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </span>
          <span class="vmp-sticky__title">{{ product.title }}</span>
        </div>
        <div class="vmp-sticky__price">
          <strong data-vmp-sticky-price>{{ current_variant.price | money }}</strong>
          <span
            ><b data-vmp-sticky-discount>
              {%- if sale_percent > 0 %}{{ sale_percent }}%{% endif -%}
            </b>
            <s data-vmp-sticky-compare>
              {%- if compare_price > current_variant.price %}{{ compare_price | money }}{% endif -%}
            </s></span
          >
        </div>
        <div class="vmp-sticky__purchase">
          <div class="vmp-quantity vmp-quantity--sticky">
            <button type="button" data-vmp-sticky-minus aria-label="Decrease quantity" disabled>
              <svg
                width="10"
                height="2"
                viewBox="0 0 10 2"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <rect width="10" height="2" fill="currentColor"/>
              </svg>
            </button>
            <input type="number" value="1" min="1" inputmode="numeric" aria-label="Quantity" data-vmp-sticky-quantity>
            <button type="button" data-vmp-sticky-plus aria-label="Increase quantity">
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 10 10" fill="none">
                <path d="M6 4H10V6H6V10H4V6H0V4H4V0H6V4Z" fill="#212121"/>
              </svg>
            </button>
          </div>
          <button
            type="button"
            class="vmp-sticky__buy-now"
            data-vmp-sticky-buy-now
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            Buy it now
          </button>
          <button
            type="button"
            class="vmp-sticky__add"
            data-vmp-sticky-add
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            <span data-vmp-sticky-label>
              {%- if current_variant.available %}Add To Cart{% else %}Sold Out{% endif -%}
            </span>
            <small data-vmp-sticky-installment>Pay in 4 -{{ current_variant.price | divided_by: 4 | money }}</small>
          </button>
        </div>
      </div>
    </div>
  {%- endif -%}
</ventral-main-product>

<script>
  (function () {
    'use strict';

    function toArray(value) {
      return Array.prototype.slice.call(value || []);
    }

    function sameOptions(left, right) {
      return (
        left.length === right.length &&
        left.every(function (value, index) {
          return value === right[index];
        })
      );
    }

    class VentralMainProduct extends HTMLElement {
      connectedCallback() {
        if (this.dataset.initialized === 'true') return;
        this.dataset.initialized = 'true';

        this.variants = this.readVariants();
        this.form = this.querySelector('.vmp-form');
        this.variantInput = this.querySelector('[data-vmp-variant-id]');
        this.quantityInput = this.querySelector('[data-vmp-quantity-input]');
        this.stickyQuantity = this.querySelector('[data-vmp-sticky-quantity]');

        this.initGallery();
        this.initOptions();
        this.initQuantity();
        this.initTabs();
        this.initForm();
        this.initStickyBar();
        this.initSocialGallery();
      }

      readVariants() {
        var script = this.querySelector('[data-vmp-variants]');
        if (!script) return [];
        try {
          return JSON.parse(script.textContent || '[]');
        } catch (error) {
          console.warn('Ventral product variants could not be read.', error);
          return [];
        }
      }

      money(cents) {
        if (window.theme && theme.Currency && typeof theme.Currency.formatMoney === 'function') {
          return theme.Currency.formatMoney(cents, theme.settings && theme.settings.moneyFormat);
        }
        if (window.Shopify && typeof Shopify.formatMoney === 'function') {
          return Shopify.formatMoney(cents);
        }
        return '$' + (Number(cents || 0) / 100).toFixed(2);
      }

      initGallery() {
        this.slides = toArray(this.querySelectorAll('[data-vmp-slide]'));
        this.thumbs = toArray(this.querySelectorAll('[data-vmp-thumb]'));
        this.galleryIndex = 0;

        this.thumbs.forEach(
          function (thumb) {
            thumb.addEventListener(
              'click',
              function () {
                this.showSlide(Number(thumb.dataset.vmpThumb || 0));
              }.bind(this)
            );
          }.bind(this)
        );

        var previous = this.querySelector('[data-vmp-gallery-prev]');
        var next = this.querySelector('[data-vmp-gallery-next]');
        if (previous)
          previous.addEventListener(
            'click',
            function () {
              this.showSlide(this.galleryIndex - 1);
            }.bind(this)
          );
        if (next)
          next.addEventListener(
            'click',
            function () {
              this.showSlide(this.galleryIndex + 1);
            }.bind(this)
          );

        this.thumbViewport = this.querySelector('[data-vmp-gallery-thumbs]');
        var thumbUp = this.querySelector('[data-vmp-thumb-up]');
        var thumbDown = this.querySelector('[data-vmp-thumb-down]');
        if (thumbUp)
          thumbUp.addEventListener(
            'click',
            function () {
              this.showSlide(this.galleryIndex - 1);
            }.bind(this)
          );
        if (thumbDown)
          thumbDown.addEventListener(
            'click',
            function () {
              this.showSlide(this.galleryIndex + 1);
            }.bind(this)
          );
      }

      showSlide(nextIndex) {
        if (!this.slides.length) return;
        var length = this.slides.length;
        this.galleryIndex = (nextIndex + length) % length;

        this.slides.forEach(
          function (slide, index) {
            var active = index === this.galleryIndex;
            slide.classList.toggle('is-active', active);
            slide.hidden = !active;
            if (!active) {
              toArray(slide.querySelectorAll('video')).forEach(function (video) {
                video.pause();
              });
            }
          }.bind(this)
        );

        var activeThumb = null;
        this.thumbs.forEach(
          function (thumb) {
            var active = Number(thumb.dataset.vmpThumb || 0) === this.galleryIndex;
            thumb.classList.toggle('is-active', active);
            thumb.setAttribute('aria-current', active ? 'true' : 'false');
            if (active) activeThumb = thumb;
          }.bind(this)
        );

        this.scrollThumbnailIntoView(activeThumb);

        var counter = this.querySelector('[data-vmp-gallery-counter]');
        if (counter) counter.textContent = this.galleryIndex + 1 + '/' + length;
      }

      scrollThumbnailIntoView(thumb) {
        var viewport = this.thumbViewport;
        if (!thumb || !viewport) return;

        var mobile = window.matchMedia('(max-width: 749px)').matches;
        var viewportStart = mobile ? viewport.scrollLeft : viewport.scrollTop;
        var viewportSize = mobile ? viewport.clientWidth : viewport.clientHeight;
        var thumbStart = mobile ? thumb.offsetLeft : thumb.offsetTop;
        var thumbSize = mobile ? thumb.offsetWidth : thumb.offsetHeight;
        var thumbEnd = thumbStart + thumbSize;

        if (thumbStart >= viewportStart && thumbEnd <= viewportStart + viewportSize) return;

        var target = thumbStart - (viewportSize - thumbSize) / 2;
        viewport.scrollTo({
          left: mobile ? target : viewport.scrollLeft,
          top: mobile ? viewport.scrollTop : target,
          behavior: 'smooth',
        });
      }

      initOptions() {
        this.optionGroups = toArray(this.querySelectorAll('[data-vmp-option]'));
        this.optionGroups.forEach(
          function (group) {
            group.addEventListener(
              'change',
              function (event) {
                if (!event.target.matches("input[type='radio']")) return;
                toArray(group.querySelectorAll('.vmp-option__value')).forEach(function (label) {
                  label.classList.toggle('is-selected', label.contains(event.target));
                });
                var valueLabel = group.querySelector('[data-vmp-option-label]');
                if (valueLabel) valueLabel.textContent = event.target.value;
                this.selectVariant();
              }.bind(this)
            );
          }.bind(this)
        );
      }

      selectVariant() {
        if (!this.optionGroups.length || !this.variants.length) return;
        var selected = this.optionGroups.map(function (group) {
          var checked = group.querySelector('input:checked');
          return checked ? checked.value : '';
        });
        var variant = this.variants.find(function (candidate) {
          return sameOptions(candidate.options || [], selected);
        });
        this.updateVariant(variant);
      }

      updateVariant(variant) {
        var available = Boolean(variant && variant.available);
        if (this.variantInput) {
          this.variantInput.value = variant ? variant.id : '';
          this.variantInput.dispatchEvent(new Event('change', { bubbles: true }));
        }

        var price = variant ? variant.price : 0;
        var compare = variant && variant.compare_at_price > price ? variant.compare_at_price : 0;
        var discount = compare ? Math.round(((compare - price) / compare) * 100) : 0;

        this.setText('[data-vmp-price]', this.money(price));
        this.setText('[data-vmp-quarter-price]', this.money(Math.round(price / 4)));
        this.setText('[data-vmp-sticky-price]', this.money(price));
        this.setText('[data-vmp-sticky-quarter]', this.money(Math.round(price / 4)));
        this.setText('[data-vmp-discount]', discount ? '-' + discount + '%' : '');
        this.setText('[data-vmp-sticky-discount]', discount ? discount + '%' : '');
        this.setText('[data-vmp-compare]', compare ? this.money(compare) : '');
        this.setText('[data-vmp-sticky-compare]', compare ? this.money(compare) : '');

        this.toggleHidden('[data-vmp-discount]', !discount);
        this.toggleHidden('[data-vmp-compare]', !compare);

        var addButton = this.querySelector('[data-vmp-add-to-cart]');
        var buyButton = this.querySelector('[data-vmp-buy-now]');
        var stickyButton = this.querySelector('[data-vmp-sticky-add]');
        var stickyBuyButton = this.querySelector('[data-vmp-sticky-buy-now]');
        var secondary = this.querySelector('[data-vmp-secondary]');

        if (addButton) addButton.disabled = !available;
        if (buyButton) {
          buyButton.disabled = !available;
          buyButton.textContent = available ? 'Buy Now' : 'Sold Out';
        }
        if (stickyButton) stickyButton.disabled = !available;
        if (stickyBuyButton) stickyBuyButton.disabled = !available;
        if (secondary) secondary.classList.toggle('is-hidden', !available);

        this.setText('[data-vmp-add-label]', available ? 'Add To Cart' : 'Sold Out');
        this.setText('[data-vmp-sticky-label]', available ? 'Add To Cart' : 'Sold Out');
        var stickySmall = stickyButton && stickyButton.querySelector('small');
        if (stickySmall && !available) stickySmall.textContent = 'Choose another item';
        if (stickySmall && available)
          stickySmall.innerHTML =
            'Pay in 4 -<span data-vmp-sticky-quarter>' + this.money(Math.round(price / 4)) + '</span>';

        this.dispatchEvent(
          new CustomEvent('variant:change', {
            bubbles: true,
            detail: { variant: variant || null },
          })
        );
      }

      setText(selector, value) {
        toArray(this.querySelectorAll(selector)).forEach(function (element) {
          element.textContent = value;
        });
      }

      toggleHidden(selector, hidden) {
        toArray(this.querySelectorAll(selector)).forEach(function (element) {
          element.classList.toggle('is-hidden', hidden);
        });
      }

      initQuantity() {
        var update = function (value) {
          value = Math.max(1, parseInt(value, 10) || 1);
          if (this.quantityInput) this.quantityInput.value = value;
          if (this.stickyQuantity) this.stickyQuantity.value = value;
          toArray(this.querySelectorAll('[data-vmp-quantity-minus], [data-vmp-sticky-minus]')).forEach(function (
            button
          ) {
            button.disabled = value <= 1;
          });
        }.bind(this);

        var bindPair = function (minusSelector, plusSelector, input) {
          var minus = this.querySelector(minusSelector);
          var plus = this.querySelector(plusSelector);
          if (minus)
            minus.addEventListener('click', function () {
              update((input && input.value) - 1);
            });
          if (plus)
            plus.addEventListener('click', function () {
              update((parseInt(input && input.value, 10) || 1) + 1);
            });
          if (input)
            input.addEventListener('change', function () {
              update(input.value);
            });
        }.bind(this);

        bindPair('[data-vmp-quantity-minus]', '[data-vmp-quantity-plus]', this.quantityInput);
        bindPair('[data-vmp-sticky-minus]', '[data-vmp-sticky-plus]', this.stickyQuantity);
        update(this.quantityInput ? this.quantityInput.value : this.stickyQuantity && this.stickyQuantity.value);
      }

      initTabs() {
        this.tabButtons = toArray(this.querySelectorAll('[data-vmp-tab]'));
        this.tabPanels = toArray(this.querySelectorAll('[data-vmp-panel]'));

        if (this.tabsInitialized) return;
        this.tabsInitialized = true;

        this.addEventListener(
          'click',
          function (event) {
            var button = event.target.closest('[data-vmp-tab]');
            if (button && this.contains(button)) {
              this.openTab(button.dataset.vmpTab);
              return;
            }

            var videoButton = event.target.closest('[data-vmp-video-play]');
            if (videoButton && this.contains(videoButton)) {
              this.playVideo();
              return;
            }

            var link = event.target.closest('[data-vmp-open-tab]');
            if (!link || !this.contains(link)) return;
            event.preventDefault();
            this.openTab(link.dataset.vmpOpenTab);
            var tabs = this.querySelector('[data-vmp-tabs]');
            if (tabs) tabs.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }.bind(this)
        );

        this.addEventListener(
          'keydown',
          function (event) {
            var button = event.target.closest('[data-vmp-tab]');
            if (!button || (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft')) return;
            event.preventDefault();
            this.tabButtons = toArray(this.querySelectorAll('[data-vmp-tab]'));
            var index = this.tabButtons.indexOf(button);
            var direction = event.key === 'ArrowRight' ? 1 : -1;
            var next = (index + direction + this.tabButtons.length) % this.tabButtons.length;
            this.tabButtons[next].focus();
            this.openTab(this.tabButtons[next].dataset.vmpTab);
          }.bind(this)
        );
      }

      openTab(name) {
        this.tabButtons = toArray(this.querySelectorAll('[data-vmp-tab]'));
        this.tabPanels = toArray(this.querySelectorAll('[data-vmp-panel]'));
        this.dataset.activeTab = name;
        this.tabButtons.forEach(function (button) {
          var active = button.dataset.vmpTab === name;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        this.tabPanels.forEach(function (panel) {
          var active = panel.dataset.vmpPanel === name;
          panel.classList.toggle('is-active', active);
          panel.hidden = !active;
        });
      }

      playVideo() {
        var cover = this.querySelector('[data-vmp-video-cover]');
        var player = this.querySelector('[data-vmp-video-player]');
        if (!player) return;
        if (cover) cover.hidden = true;
        player.hidden = false;
        var video = player.querySelector('video');
        if (video && typeof video.play === 'function') video.play();
        var frame = player.querySelector('iframe');
        if (frame && frame.src.indexOf('autoplay=1') === -1) {
          frame.src += (frame.src.indexOf('?') === -1 ? '?' : '&') + 'autoplay=1';
        }
      }

      initForm() {
        if (!this.form) return;
        this.form.addEventListener(
          'submit',
          function (event) {
            event.preventDefault();
            this.addToCart(false, this.querySelector('[data-vmp-add-to-cart]'));
          }.bind(this)
        );

        var buyNow = this.querySelector('[data-vmp-buy-now]');
        if (buyNow) {
          buyNow.addEventListener(
            'click',
            function () {
              this.addToCart(true, buyNow);
            }.bind(this)
          );
        }
      }

      async addToCart(goToCheckout, button) {
        if (!this.form || !this.variantInput || !this.variantInput.value || (button && button.disabled)) return;
        if (button) button.classList.add('is-loading');

        var payload = new FormData(this.form);
        try {
          var response = await fetch(this.dataset.cartAddUrl || '/cart/add.js', {
            method: 'POST',
            headers: { Accept: 'application/json' },
            body: payload,
          });
          var item = await response.json();
          if (!response.ok) throw new Error(item.description || 'Unable to add this item to cart.');

          if (goToCheckout) {
            window.location.href = '/checkout';
            return;
          }

          document.dispatchEvent(
            new CustomEvent('ajaxProduct:added', {
              bubbles: true,
              detail: { product: item, addToCartBtn: button },
            })
          );
          document.dispatchEvent(new CustomEvent('cart:build'));
        } catch (error) {
          window.alert(error.message || 'Unable to add this item to cart.');
        } finally {
          if (button) button.classList.remove('is-loading');
        }
      }

      initStickyBar() {
        var stickyAdd = this.querySelector('[data-vmp-sticky-add]');
        if (stickyAdd) {
          stickyAdd.addEventListener(
            'click',
            function () {
              if (this.quantityInput && this.stickyQuantity) this.quantityInput.value = this.stickyQuantity.value;
              this.addToCart(false, stickyAdd);
            }.bind(this)
          );
        }

        var stickyBuyNow = this.querySelector('[data-vmp-sticky-buy-now]');
        if (stickyBuyNow) {
          stickyBuyNow.addEventListener(
            'click',
            function () {
              if (this.quantityInput && this.stickyQuantity) this.quantityInput.value = this.stickyQuantity.value;
              this.addToCart(true, stickyBuyNow);
            }.bind(this)
          );
        }
      }

      initSocialGallery() {
        var viewport = this.querySelector('[data-vmp-social-viewport]');
        if (!viewport) return;
        var track = viewport.querySelector('[data-vmp-social-track]');
        var cards = toArray(viewport.querySelectorAll('[data-vmp-social-card]'));
        var dots = toArray(this.querySelectorAll('[data-vmp-social-dot]'));
        if (!cards.length) return;
        var previous = this.querySelector('[data-vmp-social-prev]');
        var next = this.querySelector('[data-vmp-social-next]');
        var activeIndex = 0;
        var updateControls = function (index) {
          activeIndex = (index + cards.length) % cards.length;
          dots.forEach(function (dot, dotIndex) {
            var active = dotIndex === activeIndex;
            dot.classList.toggle('is-active', active);
            dot.setAttribute('aria-current', active ? 'true' : 'false');
          });
        };
        var showCard = function (index) {
          index = (index + cards.length) % cards.length;
          updateControls(index);
          if (!track) return;
          var card = cards[index];
          if (!card) return;
          var mobile = window.matchMedia('(max-width: 749px)').matches;
          if (mobile) {
            viewport.scrollTo({ left: card.offsetLeft, behavior: 'smooth' });
          } else {
            var scrollLeft = card.offsetLeft - card.offsetParent.offsetLeft;
            track.scrollTo({ left: scrollLeft, behavior: 'smooth' });
          }
        };
        if (previous)
          previous.addEventListener('click', function () {
            showCard(activeIndex - 1);
          });
        if (next)
          next.addEventListener('click', function () {
            showCard(activeIndex + 1);
          });
        dots.forEach(function (dot, index) {
          dot.addEventListener('click', function () {
            showCard(index);
          });
        });

        var scrollFrame = null;
        viewport.addEventListener(
          'scroll',
          function () {
            if (scrollFrame) window.cancelAnimationFrame(scrollFrame);
            scrollFrame = window.requestAnimationFrame(function () {
              var scrollLeft = viewport.scrollLeft;
              var closest = 0;
              var closestDistance = Infinity;
              cards.forEach(function (card, index) {
                var distance = Math.abs(card.offsetLeft - scrollLeft);
                if (distance < closestDistance) {
                  closestDistance = distance;
                  closest = index;
                }
              });
              updateControls(closest);
            });
          },
          { passive: true }
        );
      }
    }

    if (!customElements.get('ventral-main-product')) {
      customElements.define('ventral-main-product', VentralMainProduct);
    }
  })();
</script>

