  <div class="vmp-tabs" data-vmp-tabs>
    <div class="vmp-tabs__nav-wrap">
      <div class="vmp-tabs__nav" role="tablist" aria-label="Product information">
        <button
          id="VmpTab-product-{{ section.id }}"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="VmpPanel-product-{{ section.id }}"
          class="is-active"
          data-vmp-tab="product"
        >
          {{ product_tab.settings.label | default: 'Product' }}
        </button>
        <button
          id="VmpTab-shipping-{{ section.id }}"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="VmpPanel-shipping-{{ section.id }}"
          data-vmp-tab="shipping"
        >
          {{ shipping_tab.settings.label | default: 'Shipping & Returns' }}
        </button>
        <button
          id="VmpTab-video-{{ section.id }}"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="VmpPanel-video-{{ section.id }}"
          data-vmp-tab="video"
        >
          {{ video_tab.settings.label | default: 'Video' }}
        </button>
        <button
          id="VmpTab-reviews-{{ section.id }}"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="VmpPanel-reviews-{{ section.id }}"
          data-vmp-tab="reviews"
        >
          {{ reviews_tab.settings.label | default: 'Reviews' }}
        </button>
      </div>
    </div>

    <section
      id="VmpPanel-product-{{ section.id }}"
      class="vmp-panel vmp-panel--product is-active"
      role="tabpanel"
      aria-labelledby="VmpTab-product-{{ section.id }}"
      data-vmp-panel="product"
      {{ product_tab.shopify_attributes }}
    >
      <div class="vmp-product-art">
        {%- if product_detail_image_count > 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'product_detail_image' -%}
              {%- assign detail_image_pc = block.settings.image_pc -%}
              {%- assign detail_image_mobile = block.settings.image_mobile | default: detail_image_pc -%}
              {%- assign detail_image_alt = block.settings.alt | default: product.title -%}
              <div class="vmp-product-art__item" {{ block.shopify_attributes }}>
                {%- if detail_image_pc != blank -%}
                  <picture class="vmp-picture">
                    <source media="(max-width: 749px)" srcset="{{ detail_image_mobile | image_url: width: 1200 }}">
                    {{
                      detail_image_pc
                      | image_url: width: 3000
                      | image_tag:
                        loading: 'lazy',
                        widths: '900, 1200, 1600, 1920, 2400, 3000',
                        sizes: '100vw',
                        alt: detail_image_alt
                    }}
                  </picture>
                {%- else -%}
                  {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- else -%}
          <p class="vmp-product-art__hint">Add "Product detail image" blocks in the theme editor to display multiple images in this tab.</p>
          {%- assign product_tab_image_pc = product_tab.settings.image_pc -%}
          {%- assign product_tab_image_mobile = product_tab.settings.image_mobile | default: product_tab_image_pc -%}
          {%- assign product_tab_image_alt = product_tab.settings.alt
            | default: 'Product specifications and technical details'
          -%}
          {%- if product_tab_image_pc != blank -%}
            <picture class="vmp-picture">
              <source media="(max-width: 749px)" srcset="{{ product_tab_image_mobile | image_url: width: 1200 }}">
              {{
                product_tab_image_pc
                | image_url: width: 3000
                | image_tag:
                  loading: 'lazy',
                  widths: '900, 1200, 1600, 1920, 2400, 3000',
                  sizes: '100vw',
                  alt: product_tab_image_alt
              }}
            </picture>
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        {%- endif -%}
      </div>
    </section>

    <section
      id="VmpPanel-shipping-{{ section.id }}"
      class="vmp-panel vmp-panel--shipping"
      role="tabpanel"
      aria-labelledby="VmpTab-shipping-{{ section.id }}"
      data-vmp-panel="shipping"
      hidden
      {{ shipping_tab.shopify_attributes }}
    >
      <div class="vmp-shipping">
        <h2>
          Shipping And<br>
          Return Policy
        </h2>
        <div class="vmp-shipping__row">
          <h3>Shipping &amp; Delivery</h3>
          <p>
            We offer free shipping within the United States. For orders outside the United States, shipping costs are
            calculated based on the destination, shipping distance, and product weight, and the final shipping fee will
            be displayed at checkout. Delivery times may vary depending on your location, shipping method, and carrier
            availability. Most U.S. orders arrive within 3–5 business days after shipment, while international orders
            typically arrive within 7–15 business days after shipment. Oversized products such as paddle boards may
            require special handling, which could affect delivery times.
          </p>
        </div>
        <div class="vmp-shipping__row">
          <h3>Order Processing</h3>
          <p>
            We are committed to providing a fast and reliable shipping experience. Once your order is placed and payment
            is verified, you will receive an order confirmation email, and we will begin preparing your order
            immediately. Orders are typically processed within 1–3 business days (excluding weekends and holidays). Once
            your order has been shipped, you will receive a shipping confirmation email with tracking information.
          </p>
