{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign form_id = 'VentralProductForm-' | append: section.id
  assign rating_value = product.metafields.reviews.rating.value.rating | default: section.settings.rating_value | default: '5.0'
  assign review_count = product.metafields.reviews.rating_count | default: section.settings.review_count | default: '82,589'
  assign product_tab = null
  assign product_detail_image_count = 0
  assign shipping_tab = null
  assign video_tab = null
  assign reviews_tab = null
  for block in section.blocks
    case block.type
      when 'product_tab'
        assign product_tab = block
      when 'product_detail_image'
        assign product_detail_image_count = product_detail_image_count | plus: 1
      when 'shipping_tab'
        assign shipping_tab = block
      when 'video_tab'
        assign video_tab = block
      when 'reviews_tab'
        assign reviews_tab = block
    endcase
  endfor
  assign compare_price = current_variant.compare_at_price
  assign sale_percent = 0
  if compare_price > current_variant.price
    assign saved_amount = compare_price | minus: current_variant.price
    assign sale_percent = saved_amount | times: 100.0 | divided_by: compare_price | round
  endif
  assign gallery_media_count = product.media.size
  if gallery_media_count == 0
    assign gallery_media_count = 1
  endif
  assign configured_social_count = 0
  for i in (1..3)
    assign social_image_key = 'social_image_' | append: i | append: '_pc'
    if section.settings[social_image_key] != blank
      assign configured_social_count = configured_social_count | plus: 1
    endif
  endfor
  assign social_render_count = configured_social_count
  if social_render_count == 0
    assign social_render_count = 3
  endif
-%}

<ventral-main-product
  id="VentralMainProduct-{{ section.id }}"
  class="vmp{% if section.settings.show_sticky_bar %} has-sticky{% endif %}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-active-tab="product"
  data-cart-add-url="{{ routes.cart_add_url }}"
  data-cart-url="{{ routes.cart_url }}"
>
  <script type="application/json" data-vmp-variants>
    {{ product.variants | json }}
  </script>

  <div class="vmp__hero">
    <div class="vmp-gallery" data-vmp-gallery>
      <div class="vmp-gallery__stage">
        {%- if gallery_media_count > 1 -%}
          <button
            class="vmp-gallery__arrow vmp-gallery__arrow--prev"
            type="button"
            data-vmp-gallery-prev
            aria-label="Previous product image"
          >
            <svg
              class="vmp-gallery__arrow-icon vmp-gallery__arrow-icon--desktop"
              width="56"
              height="56"
              viewBox="0 0 56 56"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M56 28C56 12.536 43.464 0 28 0C12.536 0 0 12.536 0 28C0 43.464 12.536 56 28 56C43.464 56 56 43.464 56 28Z" fill="black" fill-opacity="0.3"/>
              <path d="M23.6152 28.709L29.708 34.8008L31.2305 33.2773L26.6621 28.708L31.2305 24.1396L29.707 22.6172L23.6152 28.709Z" fill="white"/>
            </svg>
            <svg
              class="vmp-gallery__arrow-icon vmp-gallery__arrow-icon--mobile"
              xmlns="http://www.w3.org/2000/svg"
              width="36"
              height="52"
              viewBox="0 0 36 52"
              fill="none"
            >
              <path opacity="0.25" d="M10 0C6.45639 0 3.07837 0.709419 0 1.99316V50.0059C3.07846 51.2897 6.45626 52 10 52C24.3593 51.9999 36 40.3593 36 26C36 11.6407 24.3593 0.000105561 10 0Z" fill="black"/>
              <path d="M11.2656 26.6572L16.9219 32.3145L18.3369 30.9004L14.0947 26.6572L18.3369 22.415L16.9229 21L11.2656 26.6572Z" fill="white"/>
            </svg>
          </button>
        {%- endif -%}
        <div class="vmp-gallery__slides" data-vmp-gallery-slides>
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <div
                class="vmp-gallery__slide{% if forloop.first %} is-active{% endif %}"
                data-vmp-slide="{{ forloop.index0 }}"
                {% unless forloop.first %}
                  hidden
                {% endunless %}
              >
                {%- case media.media_type -%}
                  {%- when 'video' -%}
                    {{ media | video_tag: controls: true, preload: 'metadata', image_size: '1400x' }}
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag }}
                  {%- when 'model' -%}
                    {{ media | model_viewer_tag: image_size: '1400x', reveal: 'interaction', toggleable: true }}
                  {%- else -%}
                    {{
                      media.preview_image
                      | image_url: width: 1600
                      | image_tag:
                        loading: 'eager',
                        widths: '600, 900, 1200, 1600',
                        sizes: '(max-width: 749px) 100vw, 664px',
                        alt: media.alt
                      | default: product.title
                    }}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          {%- else -%}
            {%- assign fallback_product_image_pc = section.settings.fallback_product_image_pc -%}
            {%- assign fallback_product_image_mobile = section.settings.fallback_product_image_mobile
              | default: fallback_product_image_pc
            -%}
            <div class="vmp-gallery__slide is-active" data-vmp-slide="0">
              {%- if fallback_product_image_pc != blank -%}
                <picture class="vmp-picture">
                  <source
                    media="(max-width: 749px)"
                    srcset="{{ fallback_product_image_mobile | image_url: width: 900 }}"
                  >
                  {{
                    fallback_product_image_pc
                    | image_url: width: 1600
                    | image_tag:
                      loading: 'eager',
                      widths: '600, 900, 1200, 1600',
                      sizes: '(max-width: 749px) 100vw, 664px',
                      alt: product.title
                  }}
                </picture>
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
        {%- if gallery_media_count > 1 -%}
          <button
            class="vmp-gallery__arrow vmp-gallery__arrow--next"
            type="button"
            data-vmp-gallery-next
            aria-label="Next product image"
          >
            <svg
              class="vmp-gallery__arrow-icon vmp-gallery__arrow-icon--desktop"
              width="56"
              height="56"
              viewBox="0 0 56 56"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path d="M0 28C0 12.536 12.536 0 28 0C43.464 0 56 12.536 56 28C56 43.464 43.464 56 28 56C12.536 56 0 43.464 0 28Z" fill="black" fill-opacity="0.3"/>
              <path d="M32.3848 28.709L26.292 34.8008L24.7695 33.2773L29.3379 28.708L24.7695 24.1396L26.293 22.6172L32.3848 28.709Z" fill="white"/>
            </svg>
            <svg
              class="vmp-gallery__arrow-icon vmp-gallery__arrow-icon--mobile"
              xmlns="http://www.w3.org/2000/svg"
              width="36"
              height="52"
              viewBox="0 0 36 52"
              fill="none"
            >
              <path opacity="0.25" d="M26 0C29.5436 0 32.9216 0.709419 36 1.99316V50.0059C32.9215 51.2897 29.5437 52 26 52C11.6407 51.9999 0 40.3593 0 26C0 11.6407 11.6407 0.000105561 26 0Z" fill="black"/>
              <path d="M24.7344 26.6572L19.0781 32.3145L17.6631 30.9004L21.9053 26.6572L17.6631 22.415L19.0771 21L24.7344 26.6572Z" fill="white"/>
            </svg>
          </button>
        {%- endif -%}
        <span class="vmp-gallery__counter" data-vmp-gallery-counter>1/{{ gallery_media_count }}</span>
      </div>

      <div class="vmp-gallery__rail">
        {%- if gallery_media_count > 1 -%}
          <button
            class="vmp-gallery__rail-button vmp-gallery__rail-button--up"
            type="button"
            data-vmp-thumb-up
            aria-label="Scroll thumbnails up"
          >
            <svg width="70" height="24" viewBox="0 0 70 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <mask id="path-1-inside-1_1677_575" fill="white">
              <path d="M0 24H70V10C70 4.47715 65.5229 0 60 0H10C4.47715 0 0 4.47715 0 10V24Z"/>
              </mask>
              <path d="M0 24H70V10C70 4.47715 65.5229 0 60 0H10C4.47715 0 0 4.47715 0 10V24Z" fill="#F2F2F2"/>
              <path d="M0 25H70V23H0V25ZM0 23M70 0H0H70M70 0M0 0V24V0M0 0M70 24V0V24" fill="#999999" mask="url(#path-1-inside-1_1677_575)"/>
              <path d="M35 8.46387L40.6572 14.1201L39.2432 15.5352L35 11.293L30.7578 15.5352L29.3428 14.1211L35 8.46387Z" fill="#545454"/>
            </svg>
          </button>
        {%- endif -%}
        <div class="vmp-gallery__thumbs" data-vmp-gallery-thumbs>
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <button
                type="button"
                class="vmp-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-vmp-thumb="{{ forloop.index0 }}"
                aria-label="View product media {{ forloop.index }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                {{
                  media.preview_image
                  | image_url: width: 180
                  | image_tag:
                    loading: 'lazy',
                    widths: '90, 180',
                    sizes: '(max-width: 749px) 56px, 70px',
                    alt: media.alt
                  | default: product.title
                }}
              </button>
            {%- endfor -%}
          {%- else -%}
            <button
              type="button"
              class="vmp-gallery__thumb is-active"
              data-vmp-thumb="0"
              aria-label="View product image"
              aria-current="true"
            >
              {%- if section.settings.fallback_product_image_pc != blank -%}
                {{
                  section.settings.fallback_product_image_pc
                  | image_url: width: 180
                  | image_tag: loading: 'lazy', width: 70, height: 70, alt: product.title
                }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </button>
          {%- endif -%}
        </div>
        {%- if gallery_media_count > 1 -%}
          <button
            class="vmp-gallery__rail-button vmp-gallery__rail-button--down"
            type="button"
            data-vmp-thumb-down
            aria-label="Scroll thumbnails down"
          >
            <svg width="70" height="24" viewBox="0 0 70 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <mask id="path-1-inside-1_1677_602" fill="white">
              <path d="M0 0H70V14C70 19.5228 65.5229 24 60 24H10C4.47715 24 0 19.5228 0 14V0Z"/>
              </mask>
              <path d="M0 0H70V14C70 19.5228 65.5229 24 60 24H10C4.47715 24 0 19.5228 0 14V0Z" fill="#F2F2F2"/>
              <path d="M0 -1H70V1H0V-1ZM0 1M70 24H0H70M70 24M0 24V0V24M0 24M70 0V24V0" fill="#999999" mask="url(#path-1-inside-1_1677_602)"/>
              <path d="M35.5 15.5361L41.1572 9.87988L39.7432 8.46484L35.5 12.707L31.2578 8.46484L29.8428 9.87891L35.5 15.5361Z" fill="#545454"/>
            </svg>
          </button>
        {%- endif -%}
      </div>
    </div>

    <div class="vmp-buybox">
      <div class="vmp-buybox__header">
        <h1 class="vmp-buybox__title">
          {{
            product.title
            | default: 'When The Platform Feels Steady, Your Focus Returns To The Mission, Not The Motion'
          }}
        </h1>
        <a class="vmp-rating" href="#VmpPanel-reviews-{{ section.id }}" data-vmp-open-tab="reviews">
          <strong>{{ rating_value }}</strong>
          <span class="vmp-stars" aria-label="{{ rating_value }} out of 5 stars">★★★★★</span>
          <span>{{ review_count }} Reviews</span>
        </a>
      </div>
      <div class="vmp-buybox__pricing">
        <div class="vmp-price" aria-live="polite">
          <span class="vmp-price__current" data-vmp-price>{{ current_variant.price | money }}</span>
          <span class="vmp-price__discount{% if sale_percent == 0 %} is-hidden{% endif %}" data-vmp-discount>
            {%- if sale_percent > 0 %}-{{ sale_percent }}%{% endif -%}
          </span>
          <s
            class="vmp-price__compare{% unless compare_price > current_variant.price %} is-hidden{% endunless %}"
            data-vmp-compare
          >
            {%- if compare_price > current_variant.price %}{{ compare_price | money }}{% endif -%}
          </s>
        </div>
        <p class="vmp-installments">
          Or 4 Interest-Free Payments Of
          <strong data-vmp-quarter-price>{{ current_variant.price | divided_by: 4 | money }}</strong> With Klarna |
          Afterpay
        </p>
      </div>
      <div class="vmp-buybox__points rte">{{ section.settings.purchase_points }}</div>

      {%- form 'product', product, id: form_id, class: 'vmp-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-vmp-variant-id>
        {%- unless product.has_only_default_variant -%}
          <div class="vmp-options">
            {%- for option in product.options_with_values -%}
              <fieldset class="vmp-option" data-vmp-option="{{ option.position }}">
                <legend>
                  {{ option.name }}: <span data-vmp-option-label>{{ option.selected_value }}</span>
                </legend>
                <div class="vmp-option__values">
                  {%- for value in option.values -%}
                    <label class="vmp-option__value{% if option.selected_value == value %} is-selected{% endif %}">
                      <input
                        type="radio"
                        name="options[{{ option.name | escape }}]"
                        value="{{ value | escape }}"
                        {% if option.selected_value == value %}
                          checked
                        {% endif %}
                      >
                      <span>{{ value }}</span>
                    </label>
                  {%- endfor -%}
                </div>
              </fieldset>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        <div class="vmp-actions">
          <div class="vmp-quantity" data-vmp-quantity>
            <button type="button" data-vmp-quantity-minus aria-label="Decrease quantity" disabled>
              <svg
                width="10"
                height="2"
                viewBox="0 0 10 2"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                aria-hidden="true"
              >
                <rect width="10" height="2" fill="currentColor"/>
              </svg>
            </button>
            <input
              type="number"
              name="quantity"
              value="1"
              min="1"
              inputmode="numeric"
              aria-label="Quantity"
              data-vmp-quantity-input
            >
            <button type="button" data-vmp-quantity-plus aria-label="Increase quantity">
              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 10 10" fill="none">
                <path d="M6 4H10V6H6V10H4V6H0V4H4V0H6V4Z" fill="#212121"/>
              </svg>
            </button>
          </div>
          <button
            type="submit"
            name="add"
            class="vmp-button vmp-button--primary"
            data-vmp-add-to-cart
            {% unless current_variant.available %}
              disabled
            {% endunless %}
          >
            <span data-vmp-add-label>
              {%- if current_variant.available %}Add To Cart{% else %}Sold Out{% endif -%}
            </span>
          </button>
        </div>
        {%- case section.settings.secondary_purchase_action -%}
          {%- when 'dynamic' -%}
            <div
              class="vmp-dynamic-checkout{% unless current_variant.available %} is-hidden{% endunless %}"
              data-vmp-secondary
            >
              {{ form | payment_button }}
            </div>
          {%- when 'buy_now' -%}
            <button
              type="button"
              class="vmp-button vmp-button--secondary"
              data-vmp-buy-now
              {% unless current_variant.available %}
                disabled
              {% endunless %}
            >
              {% if current_variant.available %}Buy Now{% else %}Sold Out{% endif %}
            </button>
        {%- endcase -%}
      {%- endform -%}

      <div class="vmp-payments" aria-label="Accepted payment methods">
        {%- assign payment_types = shop.enabled_payment_types -%}
        {%- if payment_types == blank -%}
          {%- assign payment_types = 'visa,master,american_express,paypal,shopify_pay,klarna' | split: ',' -%}
        {%- endif -%}
        {%- for type in payment_types limit: 10 -%}
          {{ type | payment_type_svg_tag }}
        {%- endfor -%}
      </div>
      <div class="vmp-benefits">
        <div>
          <span class="vmp-benefits__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M3.06445 8.41895C3.18733 8.41895 3.28898 8.43692 3.38379 8.47852L3.39453 8.4834L3.40527 8.4873L10.2402 11.125L10.2451 11.127C10.5386 11.2363 10.8334 11.477 11.0566 11.8027C11.2793 12.1278 11.4053 12.5011 11.4053 12.8398V21.6396C11.3822 22.154 11.0546 22.4336 10.667 22.4336C10.535 22.4335 10.4117 22.4129 10.3232 22.374L10.3145 22.3701L10.3047 22.3662L3.56934 19.7285L3.56641 19.7275L3.45996 19.6807C2.93393 19.4163 2.50015 18.7276 2.5 18.0137V9.21289C2.5 8.90491 2.58252 8.70308 2.67676 8.58887C2.7632 8.48425 2.88536 8.41904 3.06445 8.41895ZM21.7861 8.41895C22.1792 8.41895 22.5 8.70333 22.5 9.21289V18.0137C22.4999 18.3479 22.3703 18.7185 22.1416 19.0449C21.9123 19.3721 21.6104 19.6154 21.3145 19.7256L21.3135 19.7266L14.4795 22.2881L14.4541 22.2969C14.4471 22.2971 14.4366 22.2984 14.4219 22.2979C14.3908 22.2968 14.3588 22.2941 14.3076 22.29C14.268 22.2869 14.2151 22.2832 14.1592 22.2822V22.2812C13.9365 22.2812 13.8232 22.2182 13.7617 22.1533C13.6965 22.0843 13.6191 21.9377 13.6191 21.6396V12.8398C13.6191 12.1168 14.0382 11.4332 14.5557 11.1719L14.6602 11.125L14.6631 11.124L21.3994 8.48633L21.4092 8.48242L21.418 8.47852C21.5038 8.44085 21.625 8.41898 21.7861 8.41895ZM12.3018 2.43359C12.782 2.43359 13.2073 2.50549 13.499 2.625L13.5117 2.62988L21.2383 5.5459V5.54688L21.248 5.5498C21.4989 5.63874 21.58 5.73127 21.6045 5.7666C21.6275 5.79975 21.6328 5.82904 21.6328 5.86523C21.6324 5.87077 21.6287 5.89784 21.5996 5.93848C21.5633 5.98912 21.4671 6.08849 21.2256 6.1875L13.541 9.09668C13.2327 9.20019 12.7982 9.27051 12.3262 9.27051C11.8465 9.27046 11.4215 9.19941 11.1299 9.08008L11.1221 9.07715L11.1152 9.07422L3.38867 6.18262L3.38086 6.17969L3.22266 6.11328C3.09258 6.04811 3.04185 5.9894 3.02344 5.96289C3.00069 5.93 2.99516 5.9011 2.99512 5.86523C2.99512 5.86367 2.99648 5.8355 3.02832 5.79102C3.05546 5.75311 3.1165 5.68758 3.24707 5.61523L3.40332 5.54102L11.0918 2.62988L11.1045 2.625C11.3962 2.5055 11.8216 2.43361 12.3018 2.43359Z" stroke="#AAAAAA"/>
            </svg></span
          ><span
            >Free<br>
            Shipping</span
          >
        </div>
        <div>
          <span class="vmp-benefits__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M18.9004 2.43359L19.0049 2.44238C19.1078 2.45889 19.2061 2.49699 19.293 2.55371C19.4099 2.63003 19.5009 2.73623 19.5557 2.85742L19.5576 2.86328L21.4277 6.86816C21.4764 6.97352 21.5014 7.09105 21.5 7.21484V20.2168C21.4998 20.8813 20.9505 21.4333 20.2549 21.4336H3.74512C3.41223 21.4332 3.0942 21.3026 2.86133 21.0732C2.62904 20.8443 2.50012 20.5357 2.5 20.2158V7.20508L2.50488 7.11816C2.51422 7.03162 2.53768 6.94604 2.57422 6.86426L4.39648 2.87012L4.40039 2.86133C4.49602 2.63998 4.70182 2.48088 4.94531 2.44238L5.05273 2.43359H18.9004ZM5.56934 2.74316C5.42334 2.7434 5.27946 2.78519 5.15625 2.86523C5.03786 2.94214 4.94362 3.0516 4.88379 3.18066L3.52637 6.01855V6.02051C3.43823 6.20649 3.42664 6.41994 3.49512 6.61426L3.49609 6.61816C3.5488 6.76379 3.64448 6.88902 3.76855 6.97949C3.88522 7.06456 4.03024 7.12248 4.19141 7.12988H19.7119L19.7344 7.12793C19.8583 7.11655 19.9781 7.07478 20.084 7.00684L20.085 7.00781C20.1859 6.94307 20.2693 6.85452 20.3311 6.75098L20.333 6.75195C20.3353 6.74824 20.3367 6.74398 20.3389 6.74023C20.3397 6.73883 20.341 6.73774 20.3418 6.73633L20.3408 6.73535C20.4009 6.63209 20.4373 6.51703 20.4453 6.39844V6.39648C20.4532 6.27123 20.431 6.14565 20.3799 6.03125L20.374 6.02051L19.0186 3.18066H19.0176C18.9579 3.05174 18.8643 2.94212 18.7461 2.86523H18.7451C18.622 2.78549 18.4787 2.74309 18.332 2.74316H5.56934Z" stroke="#AAAAAA"/>
              <path d="M6.5 12H16.5L14 9" stroke="#AAAAAA"/>
              <path d="M17.5 15H7.5L10 18" stroke="#AAAAAA"/>
            </svg></span
          ><span
            >30-Day<br>
            Returns</span
          >
        </div>
        <div>
          <span class="vmp-benefits__icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
