<script>
  (() => {
    const section = document.getElementById('VentralCollection-{{ section.id }}');
    if (!section || section.dataset.initialized === 'true') return;
    section.dataset.initialized = 'true';

    const nearestItemIndex = (container, items) => {
      const scrollLeft = container.scrollLeft;
      const viewCenter = scrollLeft + container.clientWidth / 2;
      let bestIndex = 0;
      let bestDistance = Infinity;
      for (let i = 0; i < items.length; i++) {
        const itemCenter = items[i].offsetLeft + items[i].offsetWidth / 2;
        const distance = Math.abs(itemCenter - viewCenter);
        if (distance < bestDistance) {
          bestDistance = distance;
          bestIndex = i;
        }
      }
      return bestIndex;
    };

    const scrollItemIntoView = (container, item) => {
      if (!container || !item) return;
      const left = item.offsetLeft - (container.clientWidth - item.offsetWidth) / 2;
      container.scrollTo({ left, behavior: 'auto' });
    };

    const feature = section.querySelector('[data-feature-slider]');
    const featureItems = feature ? Array.from(feature.querySelectorAll('[data-feature-item]')) : [];
    const featureProgress = section.querySelector('[data-feature-progress]');
    let featureIndex = 0;

    const setFeature = (nextIndex) => {
      if (!featureItems.length) return;
      featureIndex = Math.max(0, Math.min(nextIndex, featureItems.length - 1));
      featureItems.forEach((item, index) => {
        const active = index === featureIndex;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-expanded', String(active));
      });
      if (featureProgress) {
        const travel = 23;
        const x = featureItems.length > 1 ? (travel * featureIndex) / (featureItems.length - 1) : 0;
        featureProgress.style.setProperty('--feature-progress-x', `${x}px`);
      }
    };

    featureItems.forEach((item, index) => {
      item.addEventListener('click', () => {
        if (window.matchMedia('(min-width: 769px)').matches) setFeature(index);
      });
      item.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        event.preventDefault();
        setFeature(index);
        if (window.matchMedia('(max-width: 768px)').matches) scrollItemIntoView(feature, item);
      });
    });

    let featureScrollFrame = null;
    feature?.addEventListener('scroll', () => {
      if (!window.matchMedia('(max-width: 768px)').matches || featureScrollFrame) return;
      featureScrollFrame = requestAnimationFrame(() => {
        featureScrollFrame = null;
        setFeature(nearestItemIndex(feature, featureItems));
      });
    }, { passive: true });
    setFeature(0);

    const gallery = section.querySelector('[data-gallery]');
    const viewport = gallery?.querySelector('[data-gallery-viewport]');
    const galleryItems = gallery ? Array.from(gallery.querySelectorAll('[data-gallery-item]')) : [];
    const galleryDots = gallery ? Array.from(gallery.querySelectorAll('[data-gallery-dot]')) : [];
    let galleryIndex = 0;

    const setGallery = (nextIndex) => {
      if (!galleryItems.length) return;
      galleryIndex = Math.max(0, Math.min(nextIndex, galleryItems.length - 1));
      galleryItems.forEach((item, index) => {
        item.classList.toggle('is-active', index === galleryIndex);
      });
      galleryDots.forEach((dot, index) => {
        const active = index === galleryIndex;
        dot.classList.toggle('is-active', active);
        dot.setAttribute('aria-current', String(active));
      });
    };

    galleryDots.forEach((dot, index) => dot.addEventListener('click', () => {
      setGallery(index);
      scrollItemIntoView(viewport, galleryItems[index]);
    }));

    let galleryScrollFrame = null;
    const galleryScrollHandler = () => {
      if (galleryScrollFrame) return;
      galleryScrollFrame = requestAnimationFrame(() => {
        galleryScrollFrame = null;
        setGallery(nearestItemIndex(viewport, galleryItems));
      });
    };
    viewport?.addEventListener('scroll', galleryScrollHandler, { passive: true });

    // Desktop init: scroll to item 1, suppress scroll handler to prevent wrong dot sync
    const isDesktopInit = window.matchMedia('(min-width: 769px)').matches;
    if (isDesktopInit) {
      let suppressScroll = true;
      viewport.addEventListener('scroll', () => {
        if (suppressScroll) return;
        galleryScrollHandler();
      }, { passive: true });

      setGallery(1);
      requestAnimationFrame(() => {
        scrollItemIntoView(viewport, galleryItems[1]);
        requestAnimationFrame(() => {
          suppressScroll = false;
        });
      });
    } else {
      setGallery(0);
    }
    if (viewport) {
      let isDragging = false;
      let startX = 0;
      let scrollStart = 0;

      viewport.addEventListener('mousedown', (event) => {
        isDragging = true;
        startX = event.clientX;
        scrollStart = viewport.scrollLeft;
        viewport.style.cursor = 'grabbing';
        viewport.style.userSelect = 'none';
      });

      window.addEventListener('mousemove', (event) => {
        if (!isDragging) return;
        const dx = event.clientX - startX;
        viewport.scrollLeft = scrollStart - dx;
      });

      window.addEventListener('mouseup', () => {
        if (!isDragging) return;
        isDragging = false;
        viewport.style.cursor = '';
        viewport.style.userSelect = '';
        // No snap — dot updates naturally via scroll event
      });

      // Prevent link clicks during drag
      viewport.addEventListener('click', (event) => {
        if (isDragging) event.preventDefault();
      }, true);
    }
    // Suppress the scroll event fired by init scroll — dots are set by setGallery above
    const suppressInitScroll = () => {
      viewport.removeEventListener('scroll', suppressInitScroll);
    };

    const isDesktop = window.matchMedia('(min-width: 769px)').matches;
    const galleryInitIndex = isDesktop ? 1 : 0;
    setGallery(galleryInitIndex);
    if (isDesktop) {
      viewport?.addEventListener('scroll', suppressInitScroll, { passive: true });
      requestAnimationFrame(() => scrollItemIntoView(viewport, galleryItems[1]));
    }

    if (Shopify.designMode) {
      document.addEventListener('shopify:block:select', (event) => {
        if (!section.contains(event.target)) return;
        const featureItem = event.target.closest('[data-feature-item]');
        const galleryItem = event.target.closest('[data-gallery-item]');
        if (featureItem) {
          setFeature(Number(featureItem.dataset.index));
          if (window.matchMedia('(max-width: 768px)').matches) scrollItemIntoView(feature, featureItem);
        }
        if (galleryItem) {
          setGallery(Number(galleryItem.dataset.index));
          scrollItemIntoView(viewport, galleryItem);
        }
      });
    }
  })();
</script>

<script type="application/ld+json">
  {
