{%- liquid
  assign featured_product = section.settings.featured_product
  if featured_product == blank
    assign featured_product = collection.products.first
  endif

  assign product_title = section.settings.product_card_title
  if product_title == blank and featured_product != blank
    assign product_title = featured_product.title
  endif
  if product_title == blank
    assign product_title = 'Ventral Smart Portable Electric Fishing Paddle Board'
  endif

  assign product_lifestyle_image = section.settings.product_lifestyle_image
  assign product_packshot_image = section.settings.product_packshot_image

  assign feature_count = section.blocks | where: 'type', 'feature' | size
  assign gallery_count = section.blocks | where: 'type', 'gallery_image' | size
  assign feature_collapsed_count = feature_count | minus: 1 | at_least: 1
  assign feature_collapsed_width = 50.0 | divided_by: feature_collapsed_count
-%}

<section
  id="VentralCollection-{{ section.id }}"
  class="vc-collection"
  data-ventral-collection
  data-section-id="{{ section.id }}"
>
  <div class="vc-hero">
    <picture class="vc-hero__picture">
      {%- if section.settings.banner_image_mobile != blank -%}
        <source
          media="(max-width: 768px)"
          srcset="{{ section.settings.banner_image_mobile | image_url: width: 750 }} 750w, {{ section.settings.banner_image_mobile | image_url: width: 1125 }} 1125w"
          sizes="100vw"
        >
      {%- elsif section.settings.banner_image != blank -%}
        <source
          media="(max-width: 768px)"
          srcset="{{ section.settings.banner_image | image_url: width: 750 }} 750w, {{ section.settings.banner_image | image_url: width: 1125 }} 1125w"
          sizes="100vw"
        >
      {%- elsif collection.image != blank -%}
        <source
          media="(max-width: 768px)"
          srcset="{{ collection.image | image_url: width: 750 }} 750w, {{ collection.image | image_url: width: 1125 }} 1125w"
          sizes="100vw"
        >
      {%- else -%}
        <source media="(max-width: 768px)" srcset="{{ 'collection-banner-mobile.png' | asset_url }}">
      {%- endif -%}

      {%- if section.settings.banner_image != blank -%}
        {{ section.settings.banner_image
          | image_url: width: 2880
          | image_tag:
            widths: '960, 1440, 1920, 2400, 2880',
            sizes: '100vw',
            class: 'vc-hero__image',
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {%- elsif collection.image != blank -%}
        {{ collection.image
          | image_url: width: 2880
          | image_tag:
            widths: '960, 1440, 1920, 2400, 2880',
            sizes: '100vw',
            class: 'vc-hero__image',
            loading: 'eager',
            fetchpriority: 'high'
        }}
      {%- else -%}
        <img
          class="vc-hero__image"
          src="{{ 'collection-banner-desktop.png' | asset_url }}"
          alt=""
          width="2878"
          height="800"
          loading="eager"
          fetchpriority="high"
        >
      {%- endif -%}
    </picture>
    <div class="vc-hero__shade" aria-hidden="true"></div>
    <div class="vc-hero__content">
      <h1>{{ section.settings.banner_heading | escape }}</h1>
      <p>{{ section.settings.banner_text | escape }}</p>
    </div>
  </div>

  <div class="vc-feature-section vc-section">
    <div class="vc-heading vc-heading--center">
      <h2>{{ section.settings.feature_heading | escape }}</h2>
      <p>{{ section.settings.feature_text | escape }}</p>
    </div>

    <div class="vc-feature" data-feature-slider data-count="{{ feature_count }}" style="--feature-collapsed-width: {{ feature_collapsed_width }}%;">
      {%- assign feature_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'feature' -%}
          {%- liquid
            assign feature_fallback = 'collection-feature-precise.png'
            case feature_index
              when 1
                assign feature_fallback = 'collection-feature-confident.png'
              when 2
                assign feature_fallback = 'collection-feature-capable.png'
              when 3
                assign feature_fallback = 'collection-feature-visionary.png'
            endcase
          -%}
          <article
            class="vc-feature__item{% if feature_index == 0 %} is-active{% endif %}"
            data-feature-item
            data-index="{{ feature_index }}"
            role="button"
            tabindex="0"
            aria-expanded="{% if feature_index == 0 %}true{% else %}false{% endif %}"
            {{ block.shopify_attributes }}
          >
            <picture class="vc-feature__picture">
              {%- if block.settings.image_mobile != blank -%}
                <source
                  media="(max-width: 768px)"
                  srcset="{{ block.settings.image_mobile | image_url: width: 702 }} 702w, {{ block.settings.image_mobile | image_url: width: 1053 }} 1053w"
                  sizes="calc(100vw - 24px)"
                >
              {%- endif -%}
              {%- if block.settings.image != blank -%}
                {{ block.settings.image
                  | image_url: width: 1600
                  | image_tag:
                    widths: '400, 640, 960, 1280, 1600',
                    sizes: '(max-width: 768px) calc(100vw - 24px), 640px',
                    class: 'vc-feature__image',
                    loading: 'lazy'
                }}
              {%- else -%}
                <img
                  class="vc-feature__image"
                  src="{{ feature_fallback | asset_url }}"
                  alt="{{ block.settings.title | escape }}"
                  width="888"
                  height="500"
                  loading="lazy"
                >
              {%- endif -%}
            </picture>
            <div class="vc-feature__overlay" aria-hidden="true"></div>
            <div class="vc-feature__copy">
              <h3>{{ block.settings.title | escape }}</h3>
              {%- if block.settings.description != blank -%}
                <p>{{ block.settings.description | escape }}</p>
              {%- endif -%}
            </div>
          </article>
          {%- assign feature_index = feature_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if feature_count > 1 -%}
      <div class="vc-feature-progress" aria-hidden="true">
        <span data-feature-progress style="--feature-progress: {{ 100.0 | divided_by: feature_count }}%;"></span>
      </div>
    {%- endif -%}
  </div>

  <div class="vc-product-section vc-section">
    <div class="vc-heading vc-heading--center">
      <h2 class="vc-product-heading--desktop">{{ section.settings.product_heading | escape }}</h2>
      <h2 class="vc-product-heading--mobile">{{ section.settings.product_heading_mobile | escape }}</h2>
      <p>{{ section.settings.product_text | escape }}</p>
    </div>

    <article class="vc-product-card">
      <div class="vc-product-card__lifestyle">
        {%- if product_lifestyle_image != blank -%}
          {{ product_lifestyle_image
            | image_url: width: 1280
            | image_tag:
              widths: '300, 480, 640, 960, 1280',
              sizes: '(max-width: 768px) 40vw, 640px',
              class: 'vc-product-card__lifestyle-image',
              loading: 'lazy'
          }}
        {%- else -%}
          <img
            class="vc-product-card__lifestyle-image"
            src="{{ 'collection-product-lifestyle.png' | asset_url }}"
            alt="{{ product_title | escape }}"
            width="640"
            height="640"
            loading="lazy"
          >
        {%- endif -%}
      </div>

      <div class="vc-product-card__details">
        <h3>{{ product_title | escape }}</h3>
        {%- if section.settings.product_card_description != blank -%}
          <p class="vc-product-card__description">{{ section.settings.product_card_description | escape }}</p>
        {%- endif -%}

        <div class="vc-product-card__packshot" aria-hidden="true">
          {%- liquid
            assign product_main_image = featured_product.featured_image
            if product_packshot_image != blank
              assign product_main_image = product_packshot_image
            endif
          -%}
          {%- if product_main_image != blank -%}
            {{ product_main_image
              | image_url: width: 1200
              | image_tag:
                widths: '240, 400, 600, 900, 1200',
                sizes: '(max-width: 768px) 48vw, 560px',
                class: 'vc-product-card__packshot-image',
                loading: 'lazy'
            }}
          {%- else -%}
            <img
              class="vc-product-card__packshot-image"
              src="{{ 'collection-product-packshot.png' | asset_url }}"
              alt=""
              width="555"
              height="318"
              loading="lazy"
            >
          {%- endif -%}
        </div>

        <div class="vc-product-card__price-row">
          <span class="vc-product-card__price-label">{{ section.settings.price_label | escape }}</span>
          {%- if featured_product != blank -%}
            <span class="vc-product-card__price">{{ featured_product.price | money_without_trailing_zeros | remove: ',' }}</span>
            {%- if featured_product.compare_at_price_max > featured_product.price -%}
              <s>{{ featured_product.compare_at_price_max | money_without_trailing_zeros | remove: ',' }}</s>
            {%- endif -%}
          {%- else -%}
            <span class="vc-product-card__price">$2499</span>
            <s>$3999</s>
          {%- endif -%}
        </div>

        <a
          class="vc-product-card__button"
          href="{% if featured_product != blank %}{{ featured_product.url }}{% else %}{{ collection.url }}{% endif %}"
        >
          {{ section.settings.product_button_text | escape }}
        </a>
      </div>
    </article>
  </div>

  <div class="vc-gallery-section vc-section" data-gallery data-count="{{ gallery_count }}">
    <h2>{{ section.settings.gallery_heading | escape }}</h2>

    <div class="vc-gallery" data-gallery-viewport>
      {%- assign gallery_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'gallery_image' -%}
          {%- liquid
            assign gallery_fallback = 'collection-gallery-1.png'
            case gallery_index
              when 1
                assign gallery_fallback = 'collection-gallery-2.png'
              when 2
                assign gallery_fallback = 'collection-gallery-3.png'
            endcase
          -%}
          <div
            class="vc-gallery__item{% if gallery_index == 0 %} is-active{% endif %}"
            data-gallery-item
            data-index="{{ gallery_index }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.image != blank -%}
              {{ block.settings.image
                | image_url: width: 1800
                | image_tag:
                  widths: '480, 800, 1200, 1600, 1800',
                  sizes: '(max-width: 768px) 340px, 790px',
                  class: 'vc-gallery__image',
                  loading: 'lazy'
              }}
            {%- else -%}
              <img
                class="vc-gallery__image"
                src="{{ gallery_fallback | asset_url }}"
                alt="{{ block.settings.alt | escape }}"
                width="1004"
                height="565"
                loading="lazy"
              >
            {%- endif -%}
          </div>
          {%- assign gallery_index = gallery_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if gallery_count > 1 -%}
      <div class="vc-gallery__pagination" data-gallery-pagination aria-label="Gallery pagination">
        {%- assign gallery_dot_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'gallery_image' -%}
            <button
              type="button"
              class="vc-gallery__dot{% if gallery_dot_index == 0 %} is-active{% endif %}"
              data-gallery-dot
              data-index="{{ gallery_dot_index }}"
              aria-label="Show image {{ gallery_dot_index | plus: 1 }}"
              aria-current="{% if gallery_dot_index == 0 %}true{% else %}false{% endif %}"
            ><span></span></button>
            {%- assign gallery_dot_index = gallery_dot_index | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #VentralCollection-{{ section.id }},
  #VentralCollection-{{ section.id }} * {
    box-sizing: border-box;
  }

  #VentralCollection-{{ section.id }} {
    --vc-blue-start: #54a0e2;
    --vc-blue-end: #1370a7;
    width: 100%;
    overflow: hidden;
    background: #fff;
    color: #000;
    font-family: Inter, Arial, sans-serif;
  }

  #VentralCollection-{{ section.id }} h1,
  #VentralCollection-{{ section.id }} h2,
  #VentralCollection-{{ section.id }} h3,
  #VentralCollection-{{ section.id }} p {
    margin: 0;
    font-family: Inter, Arial, sans-serif;
    letter-spacing: 0;
    text-transform: none;
  }

  #VentralCollection-{{ section.id }} img {
    display: block;
    width: 100%;
  }

  #VentralCollection-{{ section.id }} .vc-hero {
    position: relative;
    height: 800px;
    overflow: hidden;
    background: #9aa3aa;
  }

  #VentralCollection-{{ section.id }} .vc-hero__picture,
  #VentralCollection-{{ section.id }} .vc-hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #VentralCollection-{{ section.id }} .vc-hero__image {
    object-fit: cover;
    object-position: center;
  }

  #VentralCollection-{{ section.id }} .vc-hero__shade {
    display: none;
  }

  #VentralCollection-{{ section.id }} .vc-hero__content {
    position: relative;
    z-index: 1;
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;
    padding-top: 350px;
    color: #fff;
  }

  #VentralCollection-{{ section.id }} .vc-hero__content h1 {
    color: #fff;
    font-size: 64px;
    font-weight: 700;
    line-height: 1;
  }

  #VentralCollection-{{ section.id }} .vc-hero__content p {
    margin-top: 20px;
    color: #fff;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.45;
  }

  #VentralCollection-{{ section.id }} .vc-heading {
    width: min(946px, calc(100% - 48px));
    margin: 0 auto;
  }

  #VentralCollection-{{ section.id }} .vc-heading--center {
    text-align: center;
  }

  #VentralCollection-{{ section.id }} .vc-heading h2,
  #VentralCollection-{{ section.id }} .vc-gallery-section > h2 {
    color: #000;
    font-size: 48px;
    font-weight: 700;
    line-height: 1.2;
  }

  #VentralCollection-{{ section.id }} .vc-heading p {
    margin-top: 20px;
    color: #212121;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.45;
  }

  #VentralCollection-{{ section.id }} .vc-feature-section {
    min-height: 881px;
    padding: 120px 24px;
    background: #fff;
  }

  #VentralCollection-{{ section.id }} .vc-feature {
    display: flex;
    width: min(1280px, 100%);
    height: 500px;
    margin: 40px auto 0;
    overflow: hidden;
    border-radius: 24px;
    background: #121212;
  }

  #VentralCollection-{{ section.id }} .vc-feature__item {
    position: relative;
    width: var(--feature-collapsed-width);
    flex: 0 0 var(--feature-collapsed-width);
    min-width: 0;
    height: 500px;
    overflow: hidden;
    border: 0;
    border-left: 1px solid rgba(255, 255, 255, 0.45);
    background: #585858;
    cursor: pointer;
    transition: width 0.4s cubic-bezier(0.25, 0.1, 0.25, 1), flex-basis 0.4s cubic-bezier(0.25, 0.1, 0.25, 1);
    display: flex;
    flex-direction: column;
  }

  #VentralCollection-{{ section.id }} .vc-feature__item:first-child {
    border-left: 0;
  }

  #VentralCollection-{{ section.id }} .vc-feature__item.is-active {
    width: 50%;
    flex-basis: 50%;
  }

  #VentralCollection-{{ section.id }} .vc-feature__item:only-child,
  #VentralCollection-{{ section.id }} .vc-feature__item.is-active:only-child {
    width: 100%;
    flex-basis: 100%;
  }

  #VentralCollection-{{ section.id }} .vc-feature__picture,
  #VentralCollection-{{ section.id }} .vc-feature__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #VentralCollection-{{ section.id }} .vc-feature__picture,
  #VentralCollection-{{ section.id }} .vc-feature__overlay,
  #VentralCollection-{{ section.id }} .vc-feature__copy {
    pointer-events: none;
  }

  #VentralCollection-{{ section.id }} .vc-feature__image {
    object-fit: cover;
    object-position: center;
  }

  #VentralCollection-{{ section.id }} .vc-feature__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.1);
  }

  #VentralCollection-{{ section.id }} .vc-feature__copy {
    margin-top: auto;
    position: relative;
    z-index: 1;
    min-height: 98px;
    padding: 36px 20px 20px;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0) 2%, rgba(0, 0, 0, 0.8) 100%);
    color: #fff;
  }

  #VentralCollection-{{ section.id }} .vc-feature__copy h3 {
    overflow: hidden;
    color: #fff;
    font-size: 24px;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  #VentralCollection-{{ section.id }} .vc-feature__copy p {
    max-height: 0;
    opacity: 0;
    margin-top: 0;
    overflow: hidden;
    color: #fff;
    font-size: 16px;
    font-weight: 400;
    line-height: 1.4;
    transition: max-height 0.4s cubic-bezier(0.25, 0.1, 0.25, 1), opacity 0.3s ease;
  }

  #VentralCollection-{{ section.id }} .vc-feature__item.is-active .vc-feature__copy p {
    max-height: 200px;
    opacity: 1;
    margin-top: 12px;
  }

  #VentralCollection-{{ section.id }} .vc-feature-progress {
    display: none;
  }

  #VentralCollection-{{ section.id }} .vc-product-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 887px;
    padding: 120px 24px;
    background: #f5f5f7;
  }

  #VentralCollection-{{ section.id }} .vc-product-heading--mobile {
    display: none;
  }

  #VentralCollection-{{ section.id }} .vc-product-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    width: min(1280px, 100%);
    height: 506px;
    margin: 40px auto 0;
    overflow: hidden;
    border-radius: 24px;
    background: #fff;
  }

  #VentralCollection-{{ section.id }} .vc-product-card__lifestyle {
    min-width: 0;
    height: 506px;
    overflow: hidden;
  }

  #VentralCollection-{{ section.id }} .vc-product-card__lifestyle-image {
    width: 100%;
    height: 640px;
    margin-top: -116px;
    object-fit: cover;
    object-position: center;
  }

  #VentralCollection-{{ section.id }} .vc-product-card__details {
    display: grid;
    grid-template-rows: 73px 260px 34px 40px;
    row-gap: 20px;
    min-width: 0;
    height: 506px;
    padding: 19px 40px 20px;
  }

  #VentralCollection-{{ section.id }} .vc-product-card__details h3 {
    grid-row: 1;
    align-self: start;
    margin: 0;
    color: #0a101a;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.3;
  }

  #VentralCollection-{{ section.id }} .vc-product-card__description {
    display: none;
  }

  #VentralCollection-{{ section.id }} .vc-product-card__packshot {
    display: block;
    grid-row: 2;
    min-width: 0;
    height: 260px;
    overflow: hidden;
  }

  #VentralCollection-{{ section.id }} .vc-product-card__packshot-image {
    display: block;
    width: calc(100% - 5px);
    height: 318px;
    margin: -44px 0 0 5px;
    object-fit: contain;
    object-position: center;
  }

  #VentralCollection-{{ section.id }} .vc-product-card__price-row {
    grid-row: 3;
    display: flex;
    width: 100%;
    height: 34px;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  #VentralCollection-{{ section.id }} .vc-product-card__price-label {
    color: #000;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
  }

  #VentralCollection-{{ section.id }} .vc-product-card__price {
    color: #408fd4;
    font-size: 28px;
    font-weight: 900;
    line-height: 1.2;
  }

  #VentralCollection-{{ section.id }} .vc-product-card__price-row s {
    color: #a2a2a2;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.2;
  }

  #VentralCollection-{{ section.id }} .vc-product-card__button {
    grid-row: 4;
    display: flex;
    width: 100%;
    height: 40px;
    align-items: center;
    justify-content: center;
    padding: 0 20px;
    border: 1px solid #cedfe9;
    border-radius: 100px;
    background: linear-gradient(90deg, var(--vc-blue-start) 15.255%, var(--vc-blue-end) 90.325%);
    color: #fff;
    font-family: Roboto, Arial, sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
  }

  #VentralCollection-{{ section.id }} .vc-gallery-section {
    height: 702px;
    padding-top: 120px;
    background: #fff;
  }

  #VentralCollection-{{ section.id }} .vc-gallery-section > h2 {
    text-align: center;
  }

  #VentralCollection-{{ section.id }} .vc-gallery {
    display: flex;
    width: 100%;
    height: 370px;
    margin-top: 40px;
    padding: 0 max(24px, calc((100vw - 790px) / 2));
    gap: 20px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-padding-inline: max(24px, calc((100vw - 790px) / 2));
    scroll-behavior: auto;
    overscroll-behavior-x: contain;
    touch-action: pan-x;
    scrollbar-width: none;
  }

  #VentralCollection-{{ section.id }} .vc-gallery::-webkit-scrollbar {
    display: none;
  }

  #VentralCollection-{{ section.id }} .vc-gallery__item {
    position: relative;
    flex: 0 0 min(790px, calc(100vw - 48px));
    width: min(790px, calc(100vw - 48px));
    height: 370px;
    overflow: hidden;
    border-radius: 24px;
    background: #ba5d5d;
    scroll-snap-align: center;
  }

  #VentralCollection-{{ section.id }} .vc-gallery__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
  }

  #VentralCollection-{{ section.id }} .vc-gallery__pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 40px;
  }

  #VentralCollection-{{ section.id }} .vc-gallery__dot {
    position: relative;
    width: 30px;
    height: 4px;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 100px;
    background: #c4c4c4;
    cursor: pointer;
  }

  #VentralCollection-{{ section.id }} .vc-gallery__dot span {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    background: transparent;
  }

  #VentralCollection-{{ section.id }} .vc-gallery__dot.is-active span {
    background: #000;
  }

  @media (max-width: 768px) {
    #VentralCollection-{{ section.id }} .vc-hero {
      height: 240px;
    }

    #VentralCollection-{{ section.id }} .vc-hero__image {
      object-position: center;
    }

