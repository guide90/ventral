{%- liquid
  assign home_font = section.settings.home_font
  assign home_font_medium = home_font | font_modify: 'weight', '500'
  assign home_font_semibold = home_font | font_modify: 'weight', '600'
  assign home_font_bold = home_font | font_modify: 'weight', '700'
  assign video_blocks = section.blocks | where: 'type', 'video'
  assign first_video = video_blocks | first
  assign first_video_poster = first_video.settings.poster | default: first_video.settings.video.preview_image
  assign first_video_poster_mobile = first_video.settings.mobile_poster | default: first_video_poster
  assign first_video_source = first_video.settings.video.sources | where: 'format', 'mp4' | first
  if first_video_source == blank
    assign first_video_source = first_video.settings.video.sources | first
  endif
-%}

{% style %}
    {{ home_font | font_face: font_display: 'swap' }}
    {{ home_font_medium | font_face: font_display: 'swap' }}
    {{ home_font_semibold | font_face: font_display: 'swap' }}
    {{ home_font_bold | font_face: font_display: 'swap' }}

    #ventral-home-{{ section.id }} {
      font-family: {{ home_font.family }}, {{ home_font.fallback_families }};
    }

  .ventral-home {
    --vh-accent: #44b8c7;
    --vh-blue: #3983fb;
    --vh-ink: #06142e;
    --vh-muted: #959c9d;
    width: 100%;
    overflow: hidden;
    color: #fff;
    background: #000;
    font-family: Inter, Roboto, Arial, sans-serif;
  }

  .ventral-home *,
  .ventral-home *::before,
  .ventral-home *::after {
    box-sizing: border-box;
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }
  .ventral-home {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }
  .ventral-home h1,
  .ventral-home h2,
  .ventral-home h3,
  .ventral-home p {
    margin: 0;
  }
  /* .ventral-home button,
  .ventral-home a {
    font: inherit;
  } */
  .ventral-home a {
    text-decoration: none;
  }
  .vh-shell {
    width: min(1440px, calc(100% - 48px));
    margin: 0 auto;
  }
  .vh-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .vh-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: #31586b;
  }
  .vh-radius {
    overflow: hidden;
    border-radius: 24px;
  }
  .vh-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--vh-accent);
    font-size: 20px;
    font-weight: 700;
    line-height: 1;
  }
  .vh-eyebrow::before {
    width: 40px;
    height: 1px;
    border-radius: 1px;
    background: currentColor;
    content: "";
  }
  .vh-title-48 {
    font-size: 48px;
    font-weight: 700;
    line-height: 1.2;
  }
  .vh-body-16 {
    font-size: 16px;
    font-weight: 400;
    line-height: 1.45;
  }

  .vh-hero {
    position: relative;
    height: 1080px;
    overflow: hidden;
    background: #284c59;
  }
  .vh-hero__placeholder {
    background: #426978;
  }
  .vh-hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgba(2,13,24,.64) 0%, rgba(2,13,24,.14) 54%, rgba(2,13,24,0) 80%);
  }
  .vh-hero__content {
    position: absolute;
    top: 342px;
    left: max(24px, calc((100% - 1440px) / 2));
    display: flex;
    width: 656px;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }
  .vh-hero__title {
    font-size: 64px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
  }
  .vh-hero__copy {
    width: 600px;
    color: #fff;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.45;
  }
  .ventral-home .vh-pill {
    display: inline-flex;
    min-height: 50px;
    padding: 2px 28px;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 100px;
    background: #fff;
    color: #0c284c;
    font-size: 24px;
    font-weight: 600;
    line-height: 1.2;
  }

  .vh-press {
    height: 92px;
    background: linear-gradient(90deg, #123658, #0d1723);
  }
  .vh-press__row {
    display: grid;
    height: 100%;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: center;
    gap: 40px;
  }
  .vh-press__item {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-content: center;
    color: #76858d;
  }
  .vh-press__logo {
    display: flex;
    width: 100%;
    height: 52px;
    align-items: center;
    justify-content: center;
  }
  .vh-press__logo svg {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 52px;
  }

  .vh-philosophy {
    height: 740px;
    padding-top: 120px;
    background: #070a0b;
  }
  .vh-philosophy__grid {
    display: grid;
    grid-template-columns: 848px minmax(0, 552px);
    gap: 42px;
  }
  .vh-philosophy__image {
    position: relative;
    height: 500px;
    background: #3b5961;
  }
  .vh-philosophy__copy {
    padding-top: 0;
  }
  .vh-philosophy__title {
    margin-top: 6px !important;
    padding-bottom: 10px;
    border-bottom: 1px solid #2A3436;
    font-style: italic;
  }
  .vh-philosophy__point {
    padding: 19px 0;
    border-bottom: 1px solid #2A3436;
  }
  .vh-philosophy__point:last-child {
    border-bottom: 0;
  }
  .vh-philosophy__point h3 {
    margin-bottom: 12px;
    font-size: 24px;
    font-weight: 700;
    line-height: 1;
  }
  .vh-philosophy__point p {
    color: var(--vh-muted);
  }

  .vh-why {
    height: 740px;
    padding-top: 120px;
    background: #000;
  }
  .vh-why__grid {
    display: grid;
    grid-template-columns: 552px 848px;
    gap: 40px;
  }
  .vh-why__title {
    margin: 12px 0 40px !important;
    font-style: italic;
  }
  .vh-why__list {
    position: relative;
    display: flex;
    width: 340px;
    flex-direction: column;
  }
  .vh-why__numbers {
    position: absolute;
    top: 15px;
    left: 0;
    z-index: 1;
    display: block;
    width: 40px;
    height: 320px;
    pointer-events: none;
  }
  .vh-why__numbers img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .vh-why__item {
    position: relative;
    display: flex;
    height: 70px;
    align-items: center;
    padding-left: 60px;
    font-size: 24px;
    font-weight: 500;
    line-height: 1;
  }
  .vh-why__item:not(:last-child)::after {
    position: absolute;
    bottom: 0;
    left: 52px;
    width: 280px;
    height: 1px;
    background: #21303d;
    content: "";
  }
  .vh-why__number {
    display: none;
  }
  .vh-why__image {
    position: relative;
    height: 500px;
    background: #2d5564;
  }

  .vh-system {
    height: 860px;
    padding-top: 120px;
    background: radial-gradient(circle at 74% 42%, #051d3a 0, #000713 36%, #00040d 72%);
  }
  .vh-system__grid {
    display: grid;
    grid-template-columns: 575px 586px;
    justify-content: center;
    gap: 40px;
  }
  .vh-system__heading {
    width: 552px;
  }
  .vh-system__heading h2 {
    margin: 14px 0 20px;
    font-size: 48px;
    font-weight: 700;
    line-height: 1.2;
  }
  .vh-system__heading > p {
    color: var(--vh-accent);
  }
  .vh-system .vh-body-16 {
    color: #959c9d;
  }
  .vh-system__parts {
    position: relative;
    width: 575px;
    margin-top: 40px;
  }
  .vh-system__parts-picture,
  .vh-system__offer-picture {
    display: block;
    width: 100%;
  }
  .vh-system__parts-image,
  .vh-system__offer-image {
    display: block;
    width: 100%;
    height: auto;
  }
  .vh-system__parts-placeholder {
    position: relative;
    aspect-ratio: 1150 / 720;
    border-radius: 24px;
    background: #0a1625;
  }
  .vh-system__offer {
    position: relative;
    width: 586px;
    margin-top: 34px;
  }
  .vh-system__offer-placeholder {
    position: relative;
    aspect-ratio: 1;
    border-radius: 24px;
    background: #08233b;
  }

  .vh-power {
    height: 700px;
    background: #000;
  }
  .vh-power__layout {
    position: relative;
    height: 100%;
  }
  .vh-power__image {
    position: absolute;
    top: 120px;
    right: -10px;
    width: 830px;
    height: 460px;
    overflow: hidden;
    border-radius: 24px;
    background: #fff;
  }
  .vh-power__image .vh-media {
    top: -21.74%;
    right: auto;
    bottom: auto;
    left: 0;
    width: 107.6%;
    height: 129.57%;
  }
  .vh-power__copy {
    position: absolute;
    top: 120px;
    left: 0;
    width: 560px;
  }
  .vh-power__copy h2 {
    font-size: 48px;
    font-weight: 700;
    line-height: 1.2;
    font-style: italic;
  }
  .vh-power__copy p {
    margin-top: 20px;
    color: #959c9d;
    font-size: 16px;
    line-height: 1.45;
  }
  .vh-power__button {
    display: inline-flex;
    min-height: 50px;
    margin-top: 30px;
    padding: 2px 28px;
    align-items: center;
    justify-content: center;
    border-radius: 100px;
    color: #0c284c;
    background: #fff;
    font-size: 24px;
    font-weight: 600;
    line-height: normal;
    text-decoration: none;
  }

  .vh-precision {
    height: 731px;
    padding-top: 120px;
    color: #fff;
    background: #000;
  }
  .vh-precision__heading {
    text-align: center;
  }
  .vh-precision__heading h2 {
    font-size: 48px;
    font-weight: 700;
    line-height: 1.2;
    font-style: italic;
  }
  .vh-precision__heading p {
    margin-top: 20px;
    color: var(--vh-muted);
    font-size: 16px;
    line-height: 1.45;
  }
  .vh-precision__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  .vh-precision__card {
    position: relative;
    height: 470px;
    overflow: hidden;
    border-radius: 24px;
    background: #70858d;
  }
  .vh-precision__caption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    min-height: 115px;
    padding: 20px 16px 28px;
    color: #fff;
  }
  .vh-precision__caption h3 {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
  }
  .vh-precision__caption p {
    margin-top: 16px;
    font-size: 16px;
    line-height: 1.4;
  }

  .vh-fishing {
    height: 1351px;
    padding-top: 120px;
    color: #fff;
    background: #000;
  }
  .vh-fishing h2 {
    font-size: 48px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    font-style: italic;
  }
  .vh-fishing__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: 40px;
    row-gap: 40px;
    margin-top: 40px;
  }
  .vh-fishing__item {
    min-width: 0;
  }
  .vh-fishing__image {
    position: relative;
    height: 340px;
    overflow: hidden;
    border-radius: 24px;
    background: #667e87;
  }

  .vh-fishing__eyebrow {
    margin-top: 20px;
    color: var(--vh-accent) !important;
  }
  .vh-fishing__item h3 {
    margin-top: 6px;
    font-size: 24px;
    font-weight: 700;
    line-height: 1;
  }
  .vh-fishing__item > p {
    margin-top: 20px;
    color: #959C9D;
    font-size: 16px;
    line-height: 1.45;
  }

  .vh-tough {
    height: 932px;
    padding-top: 120px;
    color: #212121;
    background: #fff;
  }
  .vh-tough__heading {
    width: 946px;
    margin: 0 auto;
    text-align: center;
  }
  .vh-tough__heading h2 {
    font-size: 48px;
    font-weight: 700;
    line-height: 1.2;
    background: linear-gradient(90deg, #6dbbff, #1ea7f6);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-style: italic;
  }
  .vh-tough__heading h2 span {
    display: block;
    color: #000;
  }
  .vh-tough__heading h3 {
    margin-top: 20px;
    font-size: 20px;
    font-weight: 600;
    line-height: 1.45;
  }
  .vh-tough__heading p {
    margin-top: 12px;
    font-size: 16px;
    line-height: 1.45;
  }
  .vh-tough__images {
    display: grid;
    grid-template-columns: 600px 800px;
    gap: 40px;
    margin-top: 52px;
    align-items: start;
  }
  .vh-tough__image {
    position: relative;
    height: auto;
    background: transparent;
  }
  .vh-tough__image .vh-media {
    position: static;
    height: auto;
    object-fit: contain;
  }

  .vh-control {
    height: 915px;
    padding-top: 120px;
    color: #fff;
    background: linear-gradient(112.4666deg, #144262 1.0442%, #0e1216 100%);
  }
  .vh-control__heading {
    display: grid;
    grid-template-columns: 1fr 700px;
    align-items: start;
  }
  .vh-control__heading h2 {
    font-size: 64px;
    font-weight: 700;
    line-height: 1.2;
  }
  .vh-control__heading p {
    padding-top: 11px;
    color: var(--vh-muted);
    font-size: 16px;
    line-height: 1.45;
  }
  .vh-control__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 40px;
  }
  .vh-control__card {
    position: relative;
    height: 498px;
    margin-top: 0;
    padding: 108px 12px 20px;
    overflow: visible;
    color: #0a101a;
    background: transparent;
  }
  .vh-control__card:nth-child(even) {
    margin-top: 60px;
  }
  .vh-control__number {
    position: absolute;
    top: 0;
    left: 50%;
    display: grid;
    width: 80px;
    height: 80px;
    place-items: center;
    z-index: 2;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: #0a101a;
    font-size: 24px;
    font-weight: 500;
    transform: translateX(-50%);
  }
  .vh-control__art ~ .vh-control__number {
    background: transparent;
  }
  .vh-control__art,
  .vh-control__art-placeholder {
    position: absolute;
    z-index: 0;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .vh-control__art-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: fill;
  }
  .vh-control__art-placeholder {
    top: 50px;
    height: auto;
    border-radius: 24px;
    background: #fff;
  }
  .vh-control__label {
    position: relative;
    z-index: 1;
    margin: 0;
    color: #0a101a;
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
  }
  .vh-control__card h3 {
    position: relative;
    z-index: 1;
    margin: 12px 0 0;
    font-size: 28px;
    font-weight: 700;
    line-height: 1;
  }
  .vh-control__text {
    position: relative;
    z-index: 1;
    margin: 20px 0 0 !important;
    color: #959c9d;
    font-size: 16px;
    line-height: 1.45;
  }

  .vh-comparison {
    position: relative;
    height: 800px;
    overflow: hidden;
    background: #1a2f38;
  }
  .vh-comparison__placeholder {
    background: #274b59;
  }
  .vh-comparison__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(90.085deg, rgba(5,5,5,.71) 0%, rgba(107,107,107,0) 145.33%);
  }
  .vh-comparison__layout {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 492px 928px;
    gap: 20px;
    padding-top: 120px;
  }
  .vh-comparison__intro {
    padding-top: 40px;
  }
  .vh-comparison__intro .vh-eyebrow {
    font-style: italic;
  }
  .vh-comparison__intro h2 {
    margin-top: 6px;
    width: 493px;
    color: #fff;
    font-size: 48px;
    font-weight: 700;
    font-style: italic;
    line-height: 1.2;
  }
  .vh-comparison__intro p {
    margin-top: 20px;
    width: 493px;
    color: #fff;
    font-size: 16px;
    line-height: 1.45;
  }
  .vh-table {
    position: relative;
    height: 616px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.68);
    border-radius: 24px;
    background: rgba(26,41,49,.5);
    backdrop-filter: blur(10px);
    box-shadow: 12px 12px 20px rgba(0,3,7,.25);
  }
  .vh-table__row {
    position: relative;
    z-index: 1;
    display: grid;
    height: 64px;
    grid-template-columns: 190px 379px 359px;
    align-items: center;
    border-bottom: 1px solid #364e58;
    letter-spacing: -0.3125px;
  }
  .vh-table__row--head {
    z-index: 2;
    height: 56px;
    color: #fff;
    background: linear-gradient(90deg, #1e3c48 0%, #142b34 100%);
    font-size: 18px;
    font-weight: 600;
  }
  .vh-table__row:nth-child(2),
  .vh-table__row:nth-child(7) {
    height: 88px;
  }
  .vh-table__cell {
    align-self: stretch;
    display: flex;
    padding: 0;
    align-items: center;
    font-size: 16px;
    line-height: 24px;
    letter-spacing: -0.31px;
  }
  .vh-table__cell:first-child {
    padding: 0 20px 0 40px;
  }
  .vh-table__cell:nth-child(2) {
    padding: 0 20px;
  }
  .vh-table__cell:nth-child(3) {
    padding-left: 20px;
  }
  .vh-table__row:last-child {
    border-bottom: 0;
  }
  .vh-table__row:not(.vh-table__row--head) .vh-table__cell:first-child {
    color: #b6bec2;
    font-weight: 600;
  }
  .vh-table__row:not(.vh-table__row--head) .vh-table__cell:nth-child(2) {
    color: #fff;
    font-weight: 400;
    border-right: 1px solid rgba(255,255,255,.5);
    border-left: 1px solid rgba(255,255,255,.5);
    background: rgba(20,65,81,.5);
  }
  .vh-table__row:not(.vh-table__row--head) .vh-table__cell:nth-child(3) {
    color: #b6bec2;
    font-weight: 400;
  }

  .vh-stories {
    height: 1315px;
    padding-top: 114px;
    color: #fff;
    background: #000;
  }
  .vh-stories h2 {
    font-size: 64px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    font-style: italic;
  }
  .vh-stories__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 50px;
  }
  .vh-story {
    position: relative;
    height: 467px;
    overflow: hidden;
    border-radius: 24px;
    background: #647c85;
  }
  .vh-story__caption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 61px;
    padding: 16px 20px;
    color: #fff;
    background: linear-gradient(180deg, rgba(0,0,0,0), rgba(0,0,0,.6));
    font-size: 20px;
    font-weight: 500;
    line-height: 1.45;
  }

  .vh-immersion {
    position: relative;
    height: 1080px;
    overflow: hidden;
    background: #466776;
  }
  .vh-immersion__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vh-videos {
    height: 840px;
    padding-top: 100px;
    color: var(--vh-ink);
    background: #fff;
  }
  .vh-videos__layout {
    position: relative;
    width: 968px;
    height: 640px;
    margin: 0 auto;
  }
  .vh-videos__intro {
    position: absolute;
    top: 130px;
    left: 0;
    width: 428px;
  }
  .vh-videos__eyebrow {
    color: var(--vh-blue);
    font-size: 14px;
    font-weight: 700;
    line-height: 15px;
  }
  .vh-videos__title {
    margin-top: 12px !important;
    font-size: 54px;
    font-weight: 700;
    line-height: 1;
  }
  .vh-videos__copy {
    margin-top: 26px !important;
    color: #a5a9b7;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.45;
  }
  .vh-videos__player {
    position: absolute;
    top: 0;
    right: 0;
    width: 360px;
    height: 640px;
    overflow: hidden;
    border-radius: 24px;
    background: #866161;
  }
  .vh-videos__media {
    display: block;
    width: 100%;
