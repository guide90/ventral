    }

    .vh-faq__icon {
      top: 15px;
      right: 13px;
      width: 20px;
      height: 20px;
    }

    .vh-faq__icon svg {
      width: 20px;
      height: 20px;
    }

    .vh-faq__answer {
      padding: 0 13px 13px;
      font-size: 14px;
      line-height: 1.45;
    }

    .vh-cta {
      height: 660px;
    }

    .vh-cta__shade {
      width: 100%;
      background: linear-gradient(180deg, #002543 6%, rgba(1,12,21,0) 100%);
    }

    .vh-cta__content {
      top: 60px;
      left: 12px;
      width: calc(100% - 24px);
      gap: 0;
    }

    .vh-cta__content h2 {
      font-size: 36px;
      line-height: 1.2;
    }

    .vh-cta__content p {
      margin-top: 16px;
      font-size: 14px;
      font-weight: 500;
      line-height: 1.4;
    }

    .vh-cta .vh-pill {
      margin-top: 20px;
    }
  }

  @media (max-width: 768px) {
    .vh-shell {
      width: 100%;
      padding-right: 12px;
      padding-left: 12px;
    }

    .vh-hero {
      display: flex;
      height: auto;
      min-height: 812px;
      padding: 92px 12px 60px;
      align-items: flex-start;
      justify-content: center;
    }

    .vh-hero__content {
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
    }

    .vh-press__row {
      padding-right: 12px;
      padding-left: 12px;
    }

    .vh-philosophy {
      height: auto;
      padding: 60px 0;
    }

    .vh-philosophy__grid {
      display: flex;
      flex-direction: column;
    }

    .vh-philosophy__copy {
      display: contents;
    }

    .vh-philosophy__copy > .vh-eyebrow {
      order: 1;
    }

    .vh-philosophy__title {
      order: 2;
    }

    .vh-philosophy__image {
      position: relative;
      top: auto;
      left: auto;
      order: 3;
      width: 100%;
      height: auto;
      margin-top: 24px;
      aspect-ratio: 351 / 207;
    }

    .vh-philosophy__point {
      order: 4;
    }

    .vh-philosophy__point:first-of-type {
      margin-top: 24px;
    }

    .vh-philosophy__point:last-child {
      order: 5;
    }

    .vh-why {
      height: auto;
      padding: 60px 0;
    }

    .vh-why__grid {
      display: flex;
      flex-direction: column;
    }

    .vh-why__grid > div:first-child {
      display: contents;
    }

    .vh-why__grid .vh-eyebrow {
      order: 1;
    }

    .vh-why__title {
      order: 2;
    }

    .vh-why__image {
      position: relative;
      top: auto;
      left: auto;
      order: 3;
      width: 100%;
      height: auto;
      margin-top: 24px;
      aspect-ratio: 351 / 200;
    }

    .vh-why__list {
      order: 4;
      width: auto;
      margin-top: 20px;
      margin-right: 12px;
      margin-left: 12px;
    }

    .vh-system {
      height: auto;
      padding: 60px 0;
    }

    .vh-system__parts {
      width: 100%;
    }

    .vh-system__offer {
      height: auto;
      margin-top: 20px;
    }

    .vh-system__heading h2 {
      font-style: italic;
    }

    .vh-precision {
      height: auto;
      padding: 60px 0 40px;
    }

    .vh-precision__card {
      height: auto;
      min-height: 240px;
      aspect-ratio: 17 / 24;
    }

    .vh-fishing {
      height: auto;
      padding: 60px 0;
    }

    .vh-fishing__item {
      display: flex;
      flex-direction: column;
    }

    .vh-tough {
      height: auto;
      padding: 60px 0;
    }

    .vh-tough__image {
      height: auto;
    }

    .vh-control {
      height: auto;
      padding: 60px 0;
    }

    .vh-control__card,
    .vh-control__card:nth-child(even) {
      height: auto;
      min-height: 0;
      margin-top: 0;
      padding: 60px 12px 20px;
      aspect-ratio: 702 / 788;
    }

    .vh-control__card:nth-child(even) {
      aspect-ratio: 702 / 790;
    }

    .vh-comparison {
      height: auto;
      padding: 60px 12px;
    }

    .vh-comparison__layout {
      width: 100%;
      padding: 0;
    }

    .vh-table {
      height: auto;
      min-height: 690px;
    }

    .vh-table::before {
      position: absolute;
      top: 46px;
      bottom: 0;
      left: 33.9%;
      z-index: 0;
      width: 32.5%;
      content: '';
      border-right: 1px solid rgba(255,255,255,.5);
      border-left: 1px solid rgba(255,255,255,.5);
      background: rgba(20,65,81,.5);
      pointer-events: none;
    }

    .vh-table__row,
    .vh-table__row:nth-child(2),
    .vh-table__row:nth-child(7),
    .vh-table__row:last-child {
      height: auto;
      min-height: 61px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 14px;
      margin-top: 19px;
      padding-right: 12px;
      padding-left: 12px;
      align-items: start;
      border-bottom: 1px solid #536770;
    }

    .vh-table__row--head {
      min-height: 54px;
      margin-top: 0;
      padding: 8px 12px;
      align-items: center;
      border-bottom: 1px solid #364e58;
      background: linear-gradient(180deg, #1e3c48, #142b34);
    }

    .vh-table__row:nth-child(2) {
      margin-top: 13px;
    }

    .vh-table__row:last-child {
      border-bottom: 0;
    }

    .vh-table__row:not(.vh-table__row--head):not(:last-child)::after {
      display: none;
    }

    .vh-table__cell,
    .vh-table__cell:first-child,
    .vh-table__cell:nth-child(2),
    .vh-table__cell:nth-child(3) {
      display: block;
      padding: 0;
      align-self: start;
      letter-spacing: -0.3125px;
    }

    .vh-table__row--head .vh-table__cell {
      align-self: center;
      font-size: 16px;
      font-weight: 500;
      line-height: 1.2;
    }

    .vh-table__row:not(.vh-table__row--head) .vh-table__cell:first-child {
      color: #b6bec2;
      font-size: 14px;
      font-weight: 500;
      line-height: 1.2;
    }

    .vh-table__row:not(.vh-table__row--head) .vh-table__cell:nth-child(2),
    .vh-table__row:not(.vh-table__row--head) .vh-table__cell:nth-child(3) {
      border: 0;
      background: transparent;
      font-size: 12px;
      font-weight: 400;
      line-height: 1.2;
    }

    .vh-stories {
      height: auto;
      padding: 60px 0;
    }

    .vh-stories .vh-shell {
      width: 100%;
      padding-right: 11px;
      padding-left: 11px;
    }

    .vh-story {
      display: flex;
      height: auto;
      min-width: 0;
      flex-direction: column;
    }

    .vh-story > picture,
    .vh-story > .vh-placeholder {
      position: relative;
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1;
    }

    .vh-story > picture .vh-media {
      position: absolute;
      height: 100%;
    }

    .vh-story__caption {
      position: static;
      height: auto;
      min-height: 20px;
      margin-top: 12px;
    }

    .vh-immersion {
      height: auto;
      aspect-ratio: 375 / 812;
    }

    .vh-videos {
      height: auto;
      padding: 40px 16px 40px 8px;
    }

    .vh-videos__layout {
      display: flex;
      height: auto;
      flex-direction: column;
    }

    .vh-videos__intro {
      position: static;
      width: auto;
      margin-left: 4px;
    }

    .vh-videos__player {
      position: relative;
      top: auto;
      right: auto;
      left: auto;
      width: 100%;
      height: auto;
      margin-top: 20px;
      aspect-ratio: 351 / 624;
    }

    .vh-videos__nav {
      display: flex;
      margin-top: 20px;
      align-items: center;
      align-self: center;
      gap: 12px;
      color: #a5a9b7;
      font-size: 16px;
      font-weight: 400;
      line-height: 1.45;
    }

    .vh-videos__nav-button {
      display: block;
      width: 30px;
      height: 30px;
      padding: 0;
      border: 0;
      background: transparent;
      cursor: pointer;
    }

    .vh-videos__nav-button svg {
      display: block;
      width: 30px;
      height: 30px;
    }

    .vh-faq {
      height: auto;
      min-height: 0;
      padding: 60px 0;
    }

    .vh-faq__grid {
      width: 100%;
    }

    .vh-faq__icon {
      top: 13px;
      width: 24px;
      height: 24px;
      flex-basis: 24px;
    }

    .vh-faq__icon svg {
      width: 20px;
      height: 20px;
    }

    .vh-cta {
      display: block;
      height: auto;
      min-height: 660px;
      padding: 60px 12px;
    }

    .vh-cta__content {
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
    }
  }
{% endstyle %}

<section id="ventral-home-{{ section.id }}" class="ventral-home">
  <div class="vh-hero">
    {%- assign hero_desktop = section.settings.hero_image -%}
    {%- assign hero_mobile = section.settings.hero_image_mobile -%}
    {%- assign hero_fallback = hero_desktop | default: hero_mobile -%}
    {%- if hero_fallback != blank -%}
      <picture>
        {%- if hero_mobile != blank -%}
          <source media="(max-width: 768px)" srcset="{{ hero_mobile | image_url: width: 750 }} 750w, {{ hero_mobile | image_url: width: 1125 }} 1125w" sizes="100vw">
        {%- endif -%}
        {{
          hero_fallback
          | image_url: width: 2400
          | image_tag:
            class: 'vh-media',
            widths: '750, 1200, 1600, 1920, 2400',
            sizes: '100vw',
            preload: true,
            alt: 'Stand steady. Move freely. Go farther.'
        }}
      </picture>
    {%- else -%}
      <div class="vh-placeholder vh-hero__placeholder" aria-hidden="true"></div>
    {%- endif -%}
    <div class="vh-hero__shade"></div>
    <div class="vh-hero__content">
      <h1 class="vh-hero__title">Stand steady. Move freely. Go farther.</h1>
      <p class="vh-hero__copy">
        Designed for greater control on the water. When the platform feels steady, your focus returns to the mission,
        not the motion.
      </p>
      <a class="vh-pill" href="{{ section.settings.reserve_link | default: routes.all_products_collection_url }}"
        >Reserve Now</a
