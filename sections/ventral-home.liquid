<script>
  (() => {
    const initializeHomeVideo = (root) => {
      if (!root || root.dataset.homeVideoReady === 'true') return;
      const media = root.querySelector('[data-home-video-media]');
      const source = root.querySelector('[data-home-video-source]');
      const playButton = root.querySelector('[data-home-video-play]');
      const cards = Array.from(root.querySelectorAll('[data-home-video-card]'));
      const previousButton = root.querySelector('[data-home-video-previous]');
      const nextButton = root.querySelector('[data-home-video-next]');
      const counter = root.querySelector('[data-home-video-counter]');
      if (!media || !source || !playButton || cards.length === 0) return;
      root.dataset.homeVideoReady = 'true';
      const available = () => Boolean(source.getAttribute('src'));
      const mobileViewport = window.matchMedia('(max-width: 768px)');
      const posterFor = (element) => {
        if (mobileViewport.matches) return element.dataset.videoPosterMobile || element.dataset.videoPosterPc || '';
        return element.dataset.videoPosterPc || element.dataset.videoPosterMobile || '';
      };
      const updateButton = () => {
        playButton.hidden = !available() || !media.paused;
      };
      const updateCounter = (card) => {
        if (!counter) return;
        const index = cards.indexOf(card);
        counter.textContent = `${index + 1}/${cards.length}`;
      };
      const toggle = () => {
        if (!available()) return;
        if (media.paused) media.play().catch(updateButton);
        else media.pause();
      };
      const select = (card) => {
        media.pause();
        const url = card.dataset.videoSrc || '';
        const type = card.dataset.videoType || '';
        const poster = posterFor(card);
        const title = card.dataset.videoTitle || 'featured video';
        if (url) source.setAttribute('src', url);
        else source.removeAttribute('src');
        if (type) source.setAttribute('type', type);
        else source.removeAttribute('type');
        if (poster) media.setAttribute('poster', poster);
        else media.removeAttribute('poster');
        media.setAttribute('aria-label', `Play ${title}`);
        playButton.setAttribute('aria-label', `Play ${title}`);
        media.load();
        cards.forEach((item) => {
          const active = item === card;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        updateCounter(card);
        updateButton();
      };
      const navigate = (step) => {
        const activeIndex = cards.findIndex((card) => card.classList.contains('is-active'));
        const nextIndex = (Math.max(activeIndex, 0) + step + cards.length) % cards.length;
        select(cards[nextIndex]);
      };
      cards.forEach((card) => card.addEventListener('click', () => select(card)));
      if (previousButton) previousButton.addEventListener('click', () => navigate(-1));
      if (nextButton) nextButton.addEventListener('click', () => navigate(1));
      playButton.addEventListener('click', toggle);
      media.addEventListener('click', toggle);
      media.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          toggle();
        }
      });
      media.addEventListener('play', updateButton);
      media.addEventListener('pause', updateButton);
      media.addEventListener('ended', updateButton);
      const activeCard = cards.find((card) => card.classList.contains('is-active')) || cards[0];
      const initialPoster = posterFor(activeCard);
      if (initialPoster) media.setAttribute('poster', initialPoster);
      updateCounter(activeCard);
      updateButton();
    };
    const initializeHomeFaq = (root) => {
      if (!root || root.dataset.homeFaqReady === 'true') return;

      const items = Array.from(root.querySelectorAll('.vh-faq__item'));
      if (!items.length) return;

      root.dataset.homeFaqReady = 'true';

      const updateExpandedState = () => {
        items.forEach((item) => {
          const summary = item.querySelector('summary');
          if (summary) summary.setAttribute('aria-expanded', String(item.open));
        });
      };

      items.forEach((item) => {
        item.addEventListener('toggle', updateExpandedState);
      });

      updateExpandedState();
    };

    const root = document.getElementById('ventral-home-{{ section.id }}');
    initializeHomeVideo(root);
    initializeHomeFaq(root);

    document.addEventListener('shopify:section:load', (event) => {
      const sectionRoot = event.target.querySelector('.ventral-home');
      initializeHomeVideo(sectionRoot);
      initializeHomeFaq(sectionRoot);
    });
  })();
</script>

