      font-size: 16px;
      font-weight: 500;
      line-height: 1.2;
    }

    .vh-table__row:not(.vh-table__row--head) .vh-table__cell:first-child {
      color: #b6bec2;
      font-size: 14px;
      font-weight: 500;
      line-height: 1.2;
    }

    .vh-table__row:not(.vh-table__row--head) .vh-table__cell:nth-child(2),
