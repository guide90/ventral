                  <img src="https://cdn.shopify.com/s/files/1/0736/0344/8920/files/media-1.png?v=1785481323" width="192" height="52" alt="" loading="lazy">
                {%- when 2 -%}
                  <img src="https://cdn.shopify.com/s/files/1/0736/0344/8920/files/media-3.svg?v=1785480926" width="292" height="30" alt="" loading="lazy">
                {%- when 3 -%}
                  <img src="https://cdn.shopify.com/s/files/1/0736/0344/8920/files/media-2.svg?v=1785480927" width="102" height="52" alt="" loading="lazy">
                {%- when 4 -%}
                  <img src="https://cdn.shopify.com/s/files/1/0736/0344/8920/files/media-4.png?v=1785481322" width="168" height="30" alt="" loading="lazy">
              {%- endcase -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
