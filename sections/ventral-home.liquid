          {%- assign tough_right_mobile = section.settings.tough_image_right_mobile -%}
          {%- assign tough_right_fallback = tough_right_desktop | default: tough_right_mobile -%}
          {%- if tough_right_fallback != blank -%}
            <picture>
              {%- if tough_right_mobile != blank -%}
                <source media="(max-width: 768px)" srcset="{{ tough_right_mobile | image_url: width: 702 }} 702w, {{ tough_right_mobile | image_url: width: 1404 }} 1404w" sizes="calc(100vw - 24px)">
              {%- endif -%}
              {{
                tough_right_fallback
                | image_url: width: 1680
                | image_tag:
                  class: 'vh-media',
                  widths: '800, 1200, 1680',
                  sizes: '(max-width: 768px) calc(100vw - 24px), (max-width: 1490px) 55vw, 800px',
                  loading: 'lazy',
                  alt: ''
              }}
            </picture>
          {%- else -%}
            <div class="vh-placeholder" aria-hidden="true"></div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

  <div class="vh-control">
    <div class="vh-shell">
      <div class="vh-control__heading">
        <h2>Built around control.</h2>
        <p>
          Four core systems work together to keep the platform stable, powered, and easy to manage when the bite turns
          on.
        </p>
      </div>
      <div class="vh-control__grid">
        {%- assign control_number = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'control_card' -%}
            {%- assign control_number = control_number | plus: 1 -%}
            <article class="vh-control__card" {{ block.shopify_attributes }}>
              {%- assign control_desktop_image = block.settings.image -%}
              {%- assign control_mobile_image = block.settings.mobile_image -%}
              {%- assign control_fallback_image = control_desktop_image | default: control_mobile_image -%}
              {%- if control_fallback_image != blank -%}
                <picture class="vh-control__art" aria-hidden="true">
                  {%- if control_mobile_image != blank -%}
                    <source
                      media="(max-width: 768px)"
                      srcset="{{ control_mobile_image | image_url: width: 702 }} 702w, {{ control_mobile_image | image_url: width: 1404 }} 1404w"
                      sizes="calc(100vw - 24px)"
                    >
                  {%- endif -%}
                  {{
                    control_fallback_image
                    | image_url: width: 1380
                    | image_tag:
                      class: 'vh-control__art-image',
                      widths: '690, 1035, 1380',
                      sizes: '(max-width: 768px) calc(100vw - 24px), 345px',
                      loading: 'lazy',
                      alt: ''
                  }}
                </picture>
              {%- else -%}
                <span class="vh-control__art-placeholder" aria-hidden="true"></span>
              {%- endif -%}
              <span class="vh-control__number">{{ control_number }}</span>
              <p class="vh-control__label">{{ block.settings.label | escape }}</p>
              <h3>{{ block.settings.title | escape }}</h3>
              <p class="vh-control__text">{{ block.settings.text | escape }}</p>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="vh-comparison">
    {%- assign comparison_desktop = section.settings.comparison_image -%}
    {%- assign comparison_mobile = section.settings.comparison_image_mobile -%}
    {%- assign comparison_fallback = comparison_desktop | default: comparison_mobile -%}
    {%- if comparison_fallback != blank -%}
      <picture>
        {%- if comparison_mobile != blank -%}
          <source media="(max-width: 768px)" srcset="{{ comparison_mobile | image_url: width: 750 }} 750w, {{ comparison_mobile | image_url: width: 1125 }} 1125w" sizes="100vw">
        {%- endif -%}
        {{
          comparison_fallback
          | image_url: width: 2400
          | image_tag: class: 'vh-media', widths: '750, 1200, 1600, 1920, 2400', sizes: '100vw', loading: 'lazy', alt: ''
        }}
      </picture>
    {%- else -%}
      <div class="vh-placeholder vh-comparison__placeholder" aria-hidden="true"></div>
    {%- endif -%}
    <div class="vh-comparison__shade"></div>
    <div class="vh-shell vh-comparison__layout">
      <div class="vh-comparison__intro">
        <div class="vh-eyebrow">Comparison</div>
        <h2>Ventral Kayak VS Traditional Kayak</h2>
        <p>A fishing-first system replaces constant paddle management with stability, propulsion, and control.</p>
      </div>
      <div class="vh-table" role="table" aria-label="Ventral kayak comparison">
        <div class="vh-table__row vh-table__row--head" role="row">
          <div class="vh-table__cell" role="columnheader">Comparison</div>
          <div class="vh-table__cell" role="columnheader">Ventral Kayak</div>
          <div class="vh-table__cell" role="columnheader">Traditional Kayak</div>
        </div>
        <div class="vh-table__row" role="row">
          <div class="vh-table__cell">Stability</div>
          <div class="vh-table__cell">Twin-tube hull for superior balance and confidence</div>
          <div class="vh-table__cell">Standard hull with limited stability</div>
        </div>
        <div class="vh-table__row" role="row">
          <div class="vh-table__cell">Fishing Ready</div>
          <div class="vh-table__cell">Built-in fishing features and gear support</div>
          <div class="vh-table__cell">Requires extra accessories</div>
        </div>
        <div class="vh-table__row" role="row">
          <div class="vh-table__cell">Functionality</div>
          <div class="vh-table__cell">4-in-1: SUP + Kayak + Motor + Battery</div>
          <div class="vh-table__cell">Paddle only</div>
        </div>
        <div class="vh-table__row" role="row">
          <div class="vh-table__cell">Motor Support</div>
          <div class="vh-table__cell">Integrated motor mount for easy cruising</div>
          <div class="vh-table__cell">Usually not motor compatible</div>
        </div>
        <div class="vh-table__row" role="row">
          <div class="vh-table__cell">Range</div>
          <div class="vh-table__cell">Up to 6 hours for all-day fishing trips</div>
          <div class="vh-table__cell">Limited by paddling effort</div>
        </div>
        <div class="vh-table__row" role="row">
          <div class="vh-table__cell">Comfort</div>
          <div class="vh-table__cell">Spacious deck for standing, casting, and moving</div>
          <div class="vh-table__cell">Less space and freedom</div>
        </div>
        <div class="vh-table__row" role="row">
          <div class="vh-table__cell">Portability</div>
          <div class="vh-table__cell">Inflatable, easy to store and transport</div>
          <div class="vh-table__cell">Bulky and harder to carry</div>
        </div>
        <div class="vh-table__row" role="row">
          <div class="vh-table__cell">Experience</div>
          <div class="vh-table__cell">More stable, efficient, and beginner-friendly</div>
          <div class="vh-table__cell">Requires more balance and effort</div>
        </div>
      </div>
    </div>
  </div>

  <div class="vh-stories">
    <div class="vh-shell">
      <h2>Stories from the Water</h2>
      <div class="vh-stories__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'story' -%}
            <article class="vh-story" {{ block.shopify_attributes }}>
              {%- assign story_desktop = block.settings.image -%}
              {%- assign story_mobile = block.settings.mobile_image -%}
              {%- assign story_fallback = story_desktop | default: story_mobile -%}
              {%- if story_fallback != blank -%}
                <picture>
                  {%- if story_mobile != blank -%}
                    <source media="(max-width: 768px)" srcset="{{ story_mobile | image_url: width: 702 }} 702w, {{ story_mobile | image_url: width: 1000 }} 1000w" sizes="calc(100vw - 22px)">
                  {%- endif -%}
                  {{
                    story_fallback
                    | image_url: width: 1000
                    | image_tag:
                      class: 'vh-media',
                      widths: '500, 702, 750, 1000',
                      sizes: '(min-width: 990px) 24vw, calc(100vw - 22px)',
                      loading: 'lazy',
                      alt: block.settings.title
                  }}
                </picture>
              {%- else -%}
                <div class="vh-placeholder" aria-hidden="true"></div>
              {%- endif -%}
              <h3 class="vh-story__caption">{{ block.settings.title | escape }}</h3>
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <div class="vh-immersion">
    {%- if section.settings.immersion_video != blank -%}
      {{
        section.settings.immersion_video
        | video_tag:
          class: 'vh-immersion__video',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'auto'
      }}
    {%- else -%}
      <div class="vh-placeholder" aria-hidden="true"></div>
    {%- endif -%}
  </div>

  <div class="vh-videos">
    <div class="vh-videos__layout">
      <div class="vh-videos__intro">
        <p class="vh-videos__eyebrow">TODAY'S ADVENTURE</p>
        <h2 class="vh-videos__title">Featured Videos</h2>
        <p class="vh-videos__copy">
          From sunrise paddles to remote get aways, every journey is better when you're on the water.
        </p>
      </div>
      <div class="vh-videos__player" data-home-video-player>
        <video
          class="vh-videos__media"
          data-home-video-media
          preload="metadata"
          playsinline
          tabindex="0"
          role="button"
          aria-label="Play {{ first_video.settings.title | default: 'featured video' | escape }}"
          data-video-poster-pc="{% if first_video_poster != blank %}{{ first_video_poster | image_url: width: 1000 }}{% endif %}"
          data-video-poster-mobile="{% if first_video_poster_mobile != blank %}{{ first_video_poster_mobile | image_url: width: 1000 }}{% endif %}"
          {% if first_video_poster != blank %}
            poster="{{ first_video_poster | image_url: width: 1000 }}"
          {% endif %}
        >
          {%- if first_video_source != blank -%}
            <source data-home-video-source src="{{ first_video_source.url }}" type="{{ first_video_source.mime_type }}">
          {%- else -%}
            <source data-home-video-source>
          {%- endif -%}
        </video>
        <button
          class="vh-videos__play"
          type="button"
          data-home-video-play
          aria-label="Play {{ first_video.settings.title | default: 'featured video' | escape }}"
          {% if first_video_source == blank %}
            hidden
          {% endif %}
        >
          <svg
            width="40"
            height="40"
            viewBox="0 0 40 40"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <rect width="40" height="40" rx="20" fill="black" fill-opacity=".38"/><path d="M25.46 17.81c1.677.978 1.677 3.402 0 4.38l-7.646 4.461C16.123 27.637 14 26.418 14 24.46v-8.92c0-1.958 2.123-3.177 3.814-2.191l7.646 4.461Z" fill="white"/>
          </svg>
        </button>
      </div>
      {%- if video_blocks.size > 1 -%}
        <div class="vh-videos__nav" aria-label="Video navigation">
          <button
            class="vh-videos__nav-button"
            type="button"
            data-home-video-previous
            aria-label="Previous video"
          >
            <svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect width="30" height="30" rx="6" fill="#F1F1F1"/>
              <path d="M17.401 9C17.2621 9.00111 17.1285 9.05447 17.0253 9.15001L11.2229 14.4819C11.1516 14.5498 11.095 14.6323 11.0566 14.7241C11.0182 14.8158 10.999 14.9149 11 15.0148C10.9989 15.1145 11.0181 15.2133 11.0565 15.3049C11.0949 15.3965 11.1516 15.4788 11.2229 15.5464L17.0008 20.8507C17.0603 20.9062 17.1307 20.9479 17.2072 20.973C17.2837 20.998 17.3646 21.0058 17.4443 20.9958C17.524 20.9857 17.6007 20.9582 17.6691 20.9149C17.7375 20.8716 17.7961 20.8137 17.8407 20.7451C17.9405 20.6006 17.9863 20.424 17.9696 20.2476C17.9528 20.0712 17.8748 19.9069 17.7498 19.785L12.5527 15.0148L17.7754 10.2145C17.9008 10.0929 17.9793 9.92878 17.9964 9.75238C18.0136 9.57599 17.9682 9.39915 17.8687 9.25441C17.7486 9.08761 17.5771 9 17.401 9Z" fill="#656565"/>
            </svg>
          </button>
          <span class="vh-videos__counter" data-home-video-counter aria-live="polite">1/{{ video_blocks.size }}</span>
          <button
            class="vh-videos__nav-button"
            type="button"
            data-home-video-next
            aria-label="Next video"
          >
            <svg width="30" height="30" viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect width="30" height="30" rx="6" fill="#F1F1F1"/>
              <path d="M11.599 9C11.7379 9.00111 11.8715 9.05447 11.9747 9.15001L17.7771 14.4819C17.8484 14.5498 17.905 14.6323 17.9434 14.7241C17.9818 14.8158 18.001 14.9149 18 15.0148C18.0011 15.1145 17.9819 15.2133 17.9435 15.3049C17.9051 15.3965 17.8484 15.4788 17.7771 15.5464L11.9992 20.8507C11.9397 20.9062 11.8693 20.9479 11.7928 20.973C11.7163 20.998 11.6354 21.0058 11.5557 20.9958C11.476 20.9857 11.3993 20.9582 11.3309 20.9149C11.2625 20.8716 11.2039 20.8137 11.1593 20.7451C11.0595 20.6006 11.0137 20.424 11.0304 20.2476C11.0472 20.0712 11.1252 19.9069 11.2502 19.785L16.4473 15.0148L11.2246 10.2145C11.0992 10.0929 11.0207 9.92878 11.0036 9.75238C10.9864 9.57599 11.0318 9.39915 11.1313 9.25441C11.2514 9.08761 11.4229 9 11.599 9Z" fill="#656565"/>
            </svg>
          </button>
        </div>
      {%- endif -%}
      <div class="vh-videos__list">
        {%- for block in video_blocks -%}
          {%- assign card_poster = block.settings.poster | default: block.settings.video.preview_image -%}
          {%- assign card_poster_mobile = block.settings.mobile_poster | default: card_poster -%}
          {%- assign card_source = block.settings.video.sources | where: 'format', 'mp4' | first -%}
          {%- if card_source == blank -%}{%- assign card_source = block.settings.video.sources | first -%}{%- endif -%}
          <button
            class="vh-video-card{% if forloop.first %} is-active{% endif %}"
            type="button"
            data-home-video-card
            data-video-src="{{ card_source.url | escape }}"
            data-video-type="{{ card_source.mime_type | escape }}"
            data-video-poster-pc="{% if card_poster != blank %}{{ card_poster | image_url: width: 1000 }}{% endif %}"
            data-video-poster-mobile="{% if card_poster_mobile != blank %}{{ card_poster_mobile | image_url: width: 1000 }}{% endif %}"
            data-video-title="{{ block.settings.title | default: 'Sunrise Paddle' | escape }}"
            aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span class="vh-video-card__thumb">
              {%- if card_poster != blank or card_poster_mobile != blank -%}
                <picture>
                  {%- if card_poster_mobile != blank -%}
                    <source media="(max-width: 768px)" srcset="{{ card_poster_mobile | image_url: width: 120 }} 120w, {{ card_poster_mobile | image_url: width: 180 }} 180w" sizes="60px">
                  {%- endif -%}
                  {{
                    card_poster
                    | default: card_poster_mobile
                    | image_url: width: 180
                    | image_tag: widths: '120, 180', sizes: '60px', loading: 'lazy', alt: ''
                  }}
                </picture>
              {%- endif -%}
            </span>
            <span class="vh-video-card__details"
              ><span class="vh-video-card__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span
              ><span class="vh-video-card__title">
                {{- block.settings.title | default: 'Sunrise Paddle' | escape -}}
              </span></span
            >
          </button>
        {%- endfor -%}
      </div>
    </div>
  </div>

