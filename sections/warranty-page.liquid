      <div id="warranty-claim" class="warranty-journey">
        <h2 class="warranty-heading">{{ section.settings.claim_heading }}</h2>
        <div class="warranty-journey__visual">
          <picture class="warranty-journey__cut" aria-hidden="true">
            <source
              media="(min-width: 750px)"
              srcset="https://cdn.shopify.com/s/files/1/0736/0344/8920/files/shipping-image-pc.png?v=1784882694"
            >
            <img
              class="warranty-journey__cut-image"
              src="https://cdn.shopify.com/s/files/1/0736/0344/8920/files/shipping-image-m.png?v=1784882693"
              width="351"
              height="663"
              loading="lazy"
              alt=""
            >
          </picture>
          <div class="warranty-journey__steps">
            {% assign step_titles = 'Submit Request|Share Details|Product Review|Solution' | split: '|' -%}
            {%- assign step_copies = 'Contact our support team|Provide order info & photos|Our team reviews your request|Receive the best solution'
              | split: '|'
            -%}
            {%- for title in step_titles %}
              <article class="warranty-step">
                <p class="warranty-step__number">0{{ forloop.index }}</p>
                <div class="warranty-step__rule"></div>
                <h3 class="warranty-step__title">{{ title }}</h3>
                <p class="warranty-step__copy">{{ step_copies[forloop.index0] }}</p>
              </article>
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Warranty page",
  "class": "warranty-page-section",
  "settings": [
    { "type": "font_picker", "id": "warranty_font", "label": "Font", "default": "inter_n4" },
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image_desktop", "label": "Desktop hero image (1920 × 1080)" },
    { "type": "image_picker", "id": "hero_image_mobile", "label": "Mobile hero image (375 × 812)" },
    { "type": "text", "id": "hero_image_alt", "label": "Hero image alt text", "default": "Ventral on the water" },
    { "type": "textarea", "id": "hero_title", "label": "Hero heading", "default": "Adventure With Confidence" },
    {
      "type": "text",
      "id": "hero_copy",
      "label": "Hero copy",
      "default": "Built for the water. Backed by protection."
    },
    {
      "type": "text",
      "id": "hero_button_label_desktop",
      "label": "Desktop button label",
      "default": "Join The Adventure"
    },
    { "type": "text", "id": "hero_button_label_mobile", "label": "Mobile button label", "default": "Contact Support" },
    { "type": "url", "id": "hero_button_link", "label": "Hero button link" },
    { "type": "header", "content": "Policy" },
    {
      "type": "text",
      "id": "warranty_heading",
      "label": "Warranty heading",
      "default": "Warranty"
    },
    { "type": "text", "id": "coverage_title", "label": "Warranty card title", "default": "2-Year Limited Warranty" },
    {
      "type": "textarea",
      "id": "coverage_copy",
      "label": "Warranty copy",
      "default": "Confidence starts from day one.\nFrom calm lakes to open waters, your adventure is protected. We stand behind every board with a 2-year limited warranty for quality you can trust."
    },
    {
      "type": "text",
      "id": "return_heading",
      "label": "Return heading",
      "default": "Return Policy"
    },
    { "type": "text", "id": "return_title", "label": "Return card title", "default": "30-Day Love It Guarantee" },
    {
      "type": "textarea",
      "id": "return_copy",
      "label": "Return copy",
      "default": "Your adventure should feel right from day one.\nTake your board to the water with confidence. If it’s not the perfect fit, our 30-day guarantee gives you peace of mind while you make your decision."
    },
    {
      "type": "text",
      "id": "benefits_heading",
      "label": "Benefits heading",
      "default": "Protection. Peace of Mind. Always."
    },
    { "type": "text", "id": "claim_heading", "label": "Claim heading", "default": "Warranty Claim Process" }
  ],
  "presets": [{ "name": "Warranty page" }],
  "disabled_on": { "groups": ["header", "footer", "custom.popups"] }
}
{% endschema %}
